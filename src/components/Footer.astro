---
import { withBase } from '../utils/url';
import { SITE, config } from '../config';
import { t } from '../i18n';
import SignOff from './SignOff.astro';

const year = new Date().getFullYear();
interface Props { signoff?: boolean }
const showSignoff = Astro.props.signoff !== false && config.footer.signoffs.length > 0;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    {showSignoff && <SignOff />}
    <div class="footer-inner">
      <p>
        © {year} <a href={withBase('/')} class="wavy">{SITE.title}</a> · {SITE.tagline}
      </p>
      <ul class="footer-links">
        {config.features.guestbook && <li><a href={withBase('/guestbook/')}>{t.footer.guestbook}</a></li>}
        <li><a href={withBase('/archive/')}>{t.footer.archive}</a></li>
        <li><a href={withBase('/rss.xml')}>{t.footer.rss}</a></li>
        <li><a href={withBase('/sitemap-index.xml')}>{t.footer.sitemap}</a></li>
        {SITE.github && <li><a href={withBase(SITE.github)} target="_blank" rel="noopener">{t.footer.github}</a></li>}
        <li><a href="https://astro.build" target="_blank" rel="noopener">{t.footer.builtWith}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 2px dashed var(--pencil-25);
    padding-block: 1.5rem 2.5rem;
    font-size: 0.95rem;
    color: var(--pencil-60);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-links a:hover {
    color: var(--marker);
  }
</style>
