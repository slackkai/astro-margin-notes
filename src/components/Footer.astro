---
import { SITE } from '../consts';
import SignOff from './SignOff.astro';

interface Props {
  signoff?: boolean;
}
const { signoff = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    {signoff && <SignOff />}
    <div class="footer-inner">
      <p>
        © {year} <a href="/" class="wavy">{SITE.title}</a> · {SITE.tagline}
      </p>
      <ul class="footer-links">
        <li><a href="/guestbook/">留言</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
        {SITE.github && <li><a href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>}
        <li><a href="https://astro.build" target="_blank" rel="noopener">Built with Astro</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 2px dashed var(--pencil-25);
    padding-block: 1.5rem 2.5rem;
    font-size: 0.95rem;
    color: var(--pencil-60);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-inner p {
    margin: 0;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-links a:hover {
    color: var(--marker);
  }
</style>
