---
/**
 * 关于页"工作台"：工具 / 硬件 / 正在追的问题。
 * 数据来自 src/content/about/about.md 的 workbench 字段（后台“站点设置 → 关于页”）。
 */
import { t } from '../i18n';

interface Props {
  workbench: { tools: { name: string; note?: string }[]; hardware: { name: string; note?: string }[]; questions: string[] };
}
const WORKBENCH = Astro.props.workbench;
---

<div class="bench">
  <div class="hand-card bench-card taped single reveal" style="--r:-0.6deg; --i:4">
    <h3>{t.about.tools}</h3>
    <ul>
      {WORKBENCH.tools.map((t) => (
        <li>
          <strong>{t.name}</strong>
          <span class="meta">{t.note}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="hand-card bench-card taped single reveal" style="--r:0.5deg; --i:5">
    <h3>{t.about.hardware}</h3>
    <ul>
      {WORKBENCH.hardware.map((t) => (
        <li>
          <strong>{t.name}</strong>
          <span class="meta">{t.note}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="hand-card bench-card questions reveal" style="--r:-0.3deg; --i:6">
    <svg class="clip" viewBox="0 0 24 48" aria-hidden="true">
      <path d="M8 44 V10 a4 4 0 0 1 8 0 V38 a2 2 0 0 1 -4 0 V14" />
    </svg>
    <h3>{t.about.questions}</h3>
    <ol>
      {WORKBENCH.questions.map((q) => (
        <li>{q}</li>
      ))}
    </ol>
  </div>
</div>

<style>
  .bench {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .bench {
      grid-template-columns: 1fr 1fr 1.3fr;
      align-items: start;
    }
  }
  .bench-card {
    padding: 1.4rem 1.3rem 1.1rem;
    transform: rotate(var(--r));
  }
  .bench-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }
  .bench-card ul,
  .bench-card ol {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .bench-card ul li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1.5px dashed var(--pencil-12);
    padding-bottom: 0.25rem;
  }
  .questions ol {
    counter-reset: q;
    gap: 0.6rem;
  }
  .questions ol li {
    counter-increment: q;
    padding-left: 1.8rem;
    position: relative;
    line-height: 1.5;
  }
  .questions ol li::before {
    content: counter(q);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.3rem;
    height: 1.3rem;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--marker);
    border: 1.5px solid var(--marker);
    border-radius: 50% 40% 55% 45% / 50% 55% 45% 50%;
  }
</style>
