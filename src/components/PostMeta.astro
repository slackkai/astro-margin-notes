---
/**
 * 文章元信息：字数、阅读时长、最后修改（git）。
 */
import { t } from '../i18n';
import { formatDate } from '../utils/content';

interface Props {
  words: number;
  minutes: number;
  modified?: Date | null;
}
const { words, minutes, modified } = Astro.props;
---

<p class="post-meta meta">
  <span title={t.post.wordsTitle}>✍️ {t.post.words(words)}</span>
  <span title={t.post.minutesTitle}>⏱️ {t.post.minutes(minutes)}</span>
  {modified && <span title={t.post.modifiedTitle}>🛠️ {t.post.modified(formatDate(modified))}</span>}
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.35rem 0 0;
  }
</style>
