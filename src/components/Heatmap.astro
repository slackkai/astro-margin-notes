---
/**
 * 日常热力图：最近 N 周，每格一天，GitHub 风格五级色阶。
 */
import { getPosts } from '../utils/content';

interface Props {
  weeks?: number;
}
const { weeks: WEEKS = 20 } = Astro.props;

const posts = await getPosts('dailies');
const counts = new Map<string, number>();
const dayKey = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
for (const p of posts) counts.set(dayKey(p.data.date), (counts.get(dayKey(p.data.date)) ?? 0) + 1);

const today = new Date();
today.setHours(0, 0, 0, 0);
const end = new Date(today);
end.setDate(end.getDate() + (6 - end.getDay()));
const start = new Date(end);
start.setDate(start.getDate() - WEEKS * 7 + 1);

const weeks: { date: Date; key: string; n: number; future: boolean }[][] = [];
for (let w = 0; w < WEEKS; w++) {
  const col = [];
  for (let d = 0; d < 7; d++) {
    const date = new Date(start);
    date.setDate(start.getDate() + w * 7 + d);
    const key = dayKey(date);
    col.push({ date, key, n: counts.get(key) ?? 0, future: date > today });
  }
  weeks.push(col);
}
const monthLabels = weeks.map((col, i) => {
  const d = col[0].date;
  const prev = i > 0 ? weeks[i - 1][0].date : null;
  return !prev || prev.getMonth() !== d.getMonth() ? `${d.getMonth() + 1}月` : '';
});
const total = posts.filter((p) => p.data.date >= start).length;
const level = (n: number) => (n === 0 ? 0 : n === 1 ? 1 : n === 2 ? 2 : n === 3 ? 3 : 4);
---

<div class="heat hand-card">
  <div class="heat-head">
    <strong>最近 {WEEKS} 周</strong>
    <span class="meta">写了 {total} 条日常</span>
  </div>
  <div class="heat-scroll">
    <div class="months" style={`--cols:${WEEKS}`}>
      {monthLabels.map((m) => <span>{m}</span>)}
    </div>
    <div class="cells" style={`--cols:${WEEKS}`}>
      {
        weeks.map((col) => (
          <div class="col">
            {col.map((c) => (
              <span
                class:list={['cell', `l${level(c.n)}`, { future: c.future }]}
                title={`${c.key}${c.n ? ` · ${c.n} 条` : ''}`}
                style={`--jit:${((c.date.getDate() * 7) % 5) - 2}deg`}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="legend meta">
    少 <span class="cell l0" /><span class="cell l1" /><span class="cell l2" /><span class="cell l3" /><span class="cell l4" /> 多
  </div>
</div>

<style>
  .heat {
    --h0: #ebedf0;
    --h1: #9be9a8;
    --h2: #40c463;
    --h3: #30a14e;
    --h4: #216e39;
    padding: 1.1rem 1.25rem 0.9rem;
    display: inline-block;
    max-width: 100%;
  }
  :global(html[data-theme='dark']) .heat {
    --h0: #2b3040;
    --h1: #0e4429;
    --h2: #006d32;
    --h3: #26a641;
    --h4: #39d353;
  }
  .heat-head {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }
  .heat-scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .months,
  .cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1rem);
    gap: 0.25rem;
  }
  .months {
    font-size: 0.7rem;
    color: var(--pencil-45);
    margin-bottom: 0.2rem;
    white-space: nowrap;
  }
  .col {
    display: grid;
    grid-template-rows: repeat(7, 1rem);
    gap: 0.25rem;
  }
  .cell {
    width: 1rem;
    height: 1rem;
    display: inline-block;
    border: 1.5px solid rgba(0, 0, 0, 0.06);
    border-radius: 3px 5px 4px 5px / 5px 4px 5px 3px;
    background: var(--h0);
    transform: rotate(var(--jit, 0deg));
    transition: transform 0.12s ease;
  }
  .cell:hover {
    transform: rotate(0deg) scale(1.25);
    border-color: var(--pencil);
  }
  .cell.l1 {
    background: var(--h1);
  }
  .cell.l2 {
    background: var(--h2);
  }
  .cell.l3 {
    background: var(--h3);
  }
  .cell.l4 {
    background: var(--h4);
  }
  .cell.future {
    background: transparent;
    border-style: dashed;
    border-color: var(--pencil-25);
    opacity: 0.5;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.7rem;
    font-size: 0.8rem;
  }
</style>
