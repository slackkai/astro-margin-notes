---
import { withBase } from '../utils/url';
import { t } from '../i18n';
/**
 * 文章目录：宽屏时贴在左侧页边，随滚动高亮当前章节；窄屏折叠为可展开块。
 * 三级结构：顶层取正文里最高一级的标题（多数文章是 h2，用 h1 分节的文章则是 h1），
 * 下面再挂两级。宽屏下目录放不下时按顺序折叠低级标题——先收起第三级，仍放不下再收起第二级，
 * 当前章节所在的分支始终展开；折叠后仍放不下则目录自身滚动，并随页面滚动保持当前条目可见。
 * 左侧铅笔虚线轨道表示目录位置：实线和小圆钮停在当前条目，不表示全文阅读百分比，
 * 当前条目的文字像被荧光笔划过；正文结束后目录随页面向上收起。
 * 用法：const { headings } = await render(post); <Toc headings={headings} />
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  minDepth?: number;
  maxDepth?: number;
}
type Node = { heading: Heading; children: Node[] };
const topDepth = Math.max(1, Math.min(2, ...Astro.props.headings.map((h) => h.depth)));
const { headings, minDepth = topDepth, maxDepth = minDepth + 2 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
// 按标题层级建树；跳级的标题挂在最近的上一级下面。
const tree: Node[] = [];
const stack: Node[] = [];
for (const heading of items) {
  const node: Node = { heading, children: [] };
  while (stack.length > 0 && stack[stack.length - 1].heading.depth >= heading.depth) stack.pop();
  (stack.length > 0 ? stack[stack.length - 1].children : tree).push(node);
  stack.push(node);
}
const escape = (value: string) => value.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const renderList = (nodes: Node[], level: number): string =>
  `<ul class="${level === 1 ? 'toc-list' : `toc-children l${level}`}">` +
  nodes.map((node) =>
    `<li class="toc-item d${level}"><a href="${escape(withBase(`#${node.heading.slug}`))}" data-slug="${escape(node.heading.slug)}"><span class="toc-text">${escape(node.heading.text)}</span></a>` +
    (node.children.length > 0 ? renderList(node.children, level + 1) : '') + '</li>').join('') +
  '</ul>';
---

{
  items.length > 1 && (
    <nav class="toc" id="toc" aria-label={t.post.toc}>
      <details class="toc-details">
        <summary class="toc-title">{t.post.toc}</summary>
        <Fragment set:html={renderList(tree, 1)} />
      </details>
    </nav>
  )
}

<style is:global>
  @property --fade-top {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }
  @property --fade-bottom {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }
  .toc {
    max-width: var(--max-w-prose);
    margin: 0 auto 2rem;
  }
  .toc-details {
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
    padding: 0.5rem 1rem;
    background: var(--paper-2);
  }
  .toc-title {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .toc-title::before {
    content: '▸';
    color: var(--marker);
    transition: transform 0.15s ease;
  }
  .toc-details[open] .toc-title::before {
    transform: rotate(90deg);
  }
  .toc-list,
  .toc-children {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .toc-list {
    position: relative;
    margin-top: 0.5rem;
  }
  .toc-children {
    padding-top: 0.15rem;
  }
  .toc-item a {
    display: block;
    padding: 0.1rem 0.5rem;
    border-left: 2px solid transparent;
    color: color-mix(in srgb, var(--pencil) 82%, transparent);
    font-size: 0.95rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color 0.12s ease, border-color 0.2s ease;
  }
  .toc-item.d2 a {
    padding-left: 1.2rem;
    font-size: 0.88rem;
  }
  .toc-item.d3 a {
    padding-left: 1.9rem;
    font-size: 0.82rem;
  }
  .toc-item a:hover {
    color: var(--pencil);
  }
  .toc-item a.is-active {
    color: var(--marker);
    border-left-color: var(--marker);
  }
  .toc-item.is-current > a {
    color: var(--pencil);
  }
  .toc .toc-item > a.is-active {
    color: var(--marker);
  }

  .toc-fill,
  .toc-thumb {
    display: none;
  }

  /* 宽屏：贴到正文左侧页边，sticky 跟随；正文结束后随页面向上收起 */
  @media (min-width: 1200px) {
    .toc {
      position: sticky;
      top: 5.5rem;
      float: left;
      width: 12rem;
      margin: 0 0 0 calc((100% - var(--max-w-prose)) / 2 - 12rem - 2rem);
      z-index: 1;
      transform: translateY(var(--toc-shift, 0px));
      opacity: var(--toc-opacity, 1);
    }
    .toc.is-past {
      visibility: hidden;
    }
    .toc-details {
      border: 0;
      background: transparent;
      padding: 0;
    }
    .toc-title {
      display: block;
      pointer-events: none;
      font-size: 0.8rem;
      color: var(--pencil-60);
      letter-spacing: 0.24em;
    }
    .toc-title::before {
      display: none;
    }
    /* 标题下一笔记号笔短划 */
    .toc-title::after {
      content: '';
      display: block;
      width: 1.9rem;
      height: 3px;
      margin: 0.3rem 0 0 1px;
      border-radius: 3px 1px 3px 1px / 60% 40% 60% 40%;
      background: var(--marker);
      opacity: 0.75;
      transform: rotate(-2.5deg);
    }
    .toc-list {
      margin-top: 0.8rem;
      /* 底部留出余量，淡出落在视口内而不是贴着窗口底边 */
      max-height: calc(100vh - 12rem);
      padding-left: 0;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      overflow-anchor: none;
      scroll-behavior: auto;
      scrollbar-width: none;
      /* 铅笔虚线轨道：画成随内容滚动的背景，整份目录一条线，虚线不会在条目之间断开 */
      background: repeating-linear-gradient(to bottom, var(--pencil-25) 0 5px, transparent 5px 10px) 4px 0 / 2px 100% no-repeat local;
      /* 只在还有被遮住内容的一侧淡出：滚到顶或底时，第一条、最后一条完整显示 */
      --fade-top: 0rem;
      --fade-bottom: 0rem;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
      transition: --fade-top 0.2s ease, --fade-bottom 0.2s ease;
    }
    .toc-list::-webkit-scrollbar {
      display: none;
    }
    .toc-list.is-clipped-top {
      --fade-top: 2.5rem;
    }
    .toc-list.is-clipped-bottom {
      --fade-bottom: 2.5rem;
    }
    /* 层级靠缩进、字号和深浅区分；当前条目用荧光笔划过，而不是改字色 */
    .toc-list,
    .toc-children {
      gap: 0;
    }
    .toc-children {
      padding-top: 0;
    }
    .toc-item a {
      padding: 0.2rem 0 0.2rem 1.1rem;
      border-left: 0;
      font-size: 0.92rem;
      line-height: 1.5;
      color: color-mix(in srgb, var(--pencil) 86%, transparent);
    }
    .toc-item.d2 a {
      padding-left: 1.95rem;
      font-size: 0.86rem;
      color: color-mix(in srgb, var(--pencil) 80%, transparent);
    }
    .toc-item.d3 a {
      padding-left: 2.8rem;
      font-size: 0.8rem;
      color: color-mix(in srgb, var(--pencil) 76%, transparent);
    }
    .toc-item.is-current > a,
    .toc-item a:hover {
      color: var(--pencil);
    }
    .toc .toc-item > a.is-active {
      color: var(--pencil);
    }
    .toc-text {
      padding: 0.05em 0.3em;
      margin: 0 -0.3em;
      border-radius: 0.25em 0.1em 0.3em 0.15em;
      background: linear-gradient(100deg, transparent 0.5%, color-mix(in srgb, var(--marker) 16%, transparent) 1.5%, color-mix(in srgb, var(--marker) 26%, transparent) 97%, transparent 99%) no-repeat 0 0 / 0% 100%;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      transition: background-size 0.4s cubic-bezier(0.3, 0.7, 0.2, 1);
    }
    a.is-active > .toc-text {
      background-size: 100% 100%;
    }
    .toc-fill,
    .toc-thumb {
      display: block;
      position: absolute;
      top: 0;
      pointer-events: none;
    }
    .toc-fill {
      left: 4px;
      width: 2px;
      height: 0;
      border-radius: 1px;
      background: color-mix(in srgb, var(--marker) 70%, transparent);

    }
    /* 与右侧阅读进度同款的小圆钮 */
    .toc-thumb {
      left: 0;
      width: 10px;
      height: 10px;
      box-sizing: border-box;
      border: 1.5px solid var(--pencil);
      border-radius: 50% 45% 55% 50% / 55% 50% 50% 45%;
      background: var(--marker);
      opacity: 0;
      transition: scale 0.12s ease, opacity 0.2s ease;
    }
    .toc-thumb.is-placed {
      opacity: 1;
    }
    .toc-list:has(a.is-active:hover) .toc-thumb {
      scale: 1.25;
    }
    /* 分支一次切换到最终布局，避免高度动画与目录滚动互相追赶。 */
    .toc.is-fold-3 .toc-item.d2:not(.is-current) > .toc-children,
    .toc.is-fold-2 .toc-item.d1:not(.is-current) > .toc-children {
      display: none;
    }
    /* 箭头提示该分支还有子标题；点击标题会跳转并展开当前分支。 */
    .toc.is-fold-3 .toc-item.d2:has(> .toc-children):not(.is-current) > a::after,
    .toc.is-fold-2 .toc-item.d1:has(> .toc-children):not(.is-current) > a::after {
      content: '▸';
      margin-left: 0.4em;
      font-size: 0.8em;
      color: color-mix(in srgb, var(--pencil) 76%, transparent);
    }
    /* 测量折叠后的最终布局时关闭过渡 */
    .toc.is-measuring,
    .toc.is-measuring * {
      transition: none !important;
    }
  }
</style>

<script>
  let lifecycle: AbortController | undefined;
  function initToc() {
    const toc = document.getElementById('toc');
    if (!toc || toc.dataset.bound) return;
    toc.dataset.bound = '1';
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;
    document.addEventListener('astro:before-swap', () => lifecycle?.abort(), { once: true, signal });
    const list = toc.querySelector<HTMLElement>('.toc-list');
    const prose = toc.parentElement?.querySelector<HTMLElement>(':scope > .prose') ?? null;
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]')]
      .map((a) => ({ a, head: document.getElementById(a.dataset.slug!) }))
      .filter((l): l is typeof l & { head: HTMLElement } => !!l.head);
    if (!list || links.length === 0) return;

    // 宽屏默认展开
    const details = toc.querySelector<HTMLDetailsElement>('details');
    const wide = window.matchMedia('(min-width: 1200px)');
    const syncOpen = () => {
      if (details) details.open = wide.matches;
    };
    syncOpen();

    // 按目录自身的滚动位置决定哪一侧淡出。
    const edges = () => {
      const max = list.scrollHeight - list.clientHeight;
      list.classList.toggle('is-clipped-top', max > 1 && list.scrollTop > 1);
      list.classList.toggle('is-clipped-bottom', max > 1 && list.scrollTop < max - 1);
    };
    list.addEventListener('scroll', edges, { passive: true, signal });
    // 只补足被遮住的距离，已在视口内的条目不重新居中。
    const follow = () => {
      if (!wide.matches || !activeLink) return;
      const inset = Math.min(40, list.clientHeight / 4);
      const top = activeLink.offsetTop;
      const bottom = top + activeLink.offsetHeight;
      if (top < list.scrollTop + inset) list.scrollTop = Math.max(0, top - inset);
      else if (bottom > list.scrollTop + list.clientHeight - inset) {
        list.scrollTop = Math.min(top, bottom - list.clientHeight + inset);
      }
      edges();
    };

    const setFold = (fold: number) => {
      toc.classList.toggle('is-fold-3', fold >= 1);
      toc.classList.toggle('is-fold-2', fold >= 2);
    };
    const markCurrent = (items: Element[]) => {
      toc.querySelectorAll('.is-current').forEach((item) => item.classList.remove('is-current'));
      items.forEach((item) => item.classList.add('is-current'));
    };
    // 当前条目的每一级祖先都标记为当前分支，这样折叠时它们的子目录保持展开。
    const branch = (a: HTMLAnchorElement | undefined) => {
      const items: Element[] = [];
      for (let item = a?.parentElement; item && item !== list; item = item.parentElement) {
        if (item.classList.contains('toc-item')) items.push(item);
      }
      return items;
    };

    // 折叠级别只在初始化、窗口或字体尺寸变化时计算，不随当前章节反复变化。
    let activeLink: HTMLAnchorElement | undefined;
    let fold = 0;
    const layout = (recalculate = false) => {
      // 保住新条目（尚未展开时取其可见祖先）的屏幕位置。
      const anchor = branch(activeLink)
        .map((item) => item.querySelector<HTMLAnchorElement>(':scope > a'))
        .find((a) => a && a.getClientRects().length > 0);
      const before = anchor ? anchor.offsetTop - list.scrollTop : 0;
      toc.classList.add('is-measuring');
      if (recalculate) {
        // 绝对定位的轨道也会撑大 scrollHeight，测量前先归零。
        fill.style.height = '0px';
        thumb.style.transform = 'translateY(0px)';
        markCurrent([]);
        fold = 0;
        setFold(0);
        if (wide.matches) {
          const available = parseFloat(getComputedStyle(list).maxHeight) || Infinity;
          while (fold < 2 && list.scrollHeight > available) setFold(++fold);
        }
      }
      markCurrent(branch(activeLink));
      setFold(fold);
      if (wide.matches && anchor) list.scrollTop = anchor.offsetTop - before;
      follow();
      place();
      edges();
      void list.offsetHeight;
      toc.classList.remove('is-measuring');
    };

    // 轨道上的实线和圆钮。放在目录列表里，随目录自身滚动。
    const fill = document.createElement('span');
    const thumb = document.createElement('span');
    fill.className = 'toc-fill';
    thumb.className = 'toc-thumb';
    fill.ariaHidden = thumb.ariaHidden = 'true';
    list.append(fill, thumb);
    // 圆钮对齐条目第一行文字的中线，条目折成多行时也不会落到两行之间
    const measure = () => {
      if (!activeLink) return null;
      const style = getComputedStyle(activeLink);
      const height = activeLink.offsetHeight;
      const center = parseFloat(style.paddingTop) + (parseFloat(style.lineHeight) || 20) / 2;
      return { top: activeLink.offsetTop, height, center: Math.min(center, height / 2) };
    };
    const place = (geometry = measure()) => {
      if (!geometry) return;
      thumb.style.transform = `translateY(${(geometry.top + geometry.center - thumb.offsetHeight / 2).toFixed(1)}px)`;
      fill.style.height = `${(geometry.top + geometry.center).toFixed(1)}px`;
      thumb.classList.add('is-placed');
    };

    const setActive = (a: HTMLAnchorElement) => {
      if (a === activeLink) return;
      const first = !activeLink;
      activeLink?.classList.remove('is-active');
      activeLink?.removeAttribute('aria-current');
      activeLink = a;
      a.classList.add('is-active');
      a.setAttribute('aria-current', 'location');
      layout(first);
    };

    // 取视口顶部（留出 sticky 导航栏高度）以上最近的一个标题作为当前章节。
    // 用 getBoundingClientRect 而非 offsetTop：后者相对定位父元素，容器一旦 relative 就会算错。
    const LINE = 120;
    const update = () => {
      const tops = links.map((l) => l.head.getBoundingClientRect().top);
      const end = prose ? prose.getBoundingClientRect().bottom : document.documentElement.scrollHeight - window.scrollY;
      const bottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let active = 0;
      tops.forEach((top, i) => {
        if (top <= LINE) active = i;
      });
      // 滚到底时高亮最后一个
      if (bottom) active = links.length - 1;
      if (links[active].a === activeLink) place();
      else setActive(links[active].a);
      // 正文结束后目录跟着正文底边一起向上收起、淡出
      let shift = 0;
      if (wide.matches && prose) {
        const rect = toc.getBoundingClientRect();
        const previous = parseFloat(toc.style.getPropertyValue('--toc-shift')) || 0;
        const naturalBottom = rect.bottom - previous;
        shift = Math.min(0, end - naturalBottom);
        const height = Math.max(1, rect.height);
        toc.style.setProperty('--toc-opacity', String(Math.max(0, 1 + shift / height).toFixed(3)));
        toc.classList.toggle('is-past', naturalBottom + shift <= 0);
      } else {
        toc.style.removeProperty('--toc-opacity');
        toc.classList.remove('is-past');
      }
      toc.style.setProperty('--toc-shift', `${shift.toFixed(1)}px`);
    };

    // 每帧最多计算一次
    let frame = 0;
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(() => { frame = 0; update(); });
    };
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { layout(true); update(); }, 120);
    }, { signal });
    wide.addEventListener('change', () => { syncOpen(); layout(true); update(); }, { signal });
    window.addEventListener('scroll', schedule, { passive: true, signal });
    signal.addEventListener('abort', () => { cancelAnimationFrame(frame); clearTimeout(resizeTimer); });
    document.fonts.ready.then(() => {
      if (!signal.aborted) { layout(true); update(); }
    });
    update();
  }
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
