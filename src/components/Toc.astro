---
import { withBase } from '../utils/url';
import { t } from '../i18n';
/**
 * 文章目录：宽屏时贴在左侧页边，随滚动高亮当前章节；窄屏折叠为可展开块。
 * 两级结构（h2 下挂 h3）。宽屏下目录放不下时自动只展开当前章节的子目录；
 * 仍然放不下时目录自身可滚动，并随页面滚动把当前条目保持在可见范围内。
 * 用法：const { headings } = await render(post); <Toc headings={headings} />
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  minDepth?: number;
  maxDepth?: number;
}
// 默认取正文里最高一级标题作为顶层（多数文章是 h2；用 h1 分节的文章则以 h1 为顶层），再挂一级子标题。
const topDepth = Math.max(1, Math.min(2, ...Astro.props.headings.map((h) => h.depth)));
const { headings, minDepth = topDepth, maxDepth = minDepth + 1 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
// 顶层是 minDepth 的标题，更深的标题挂在前一个顶层标题下；没有父级的深层标题自成一项。
const tree: { heading: Heading; children: Heading[] }[] = [];
for (const heading of items) {
  const parent = tree.at(-1);
  if (heading.depth === minDepth || !parent) tree.push({ heading, children: [] });
  else parent.children.push(heading);
}
---

{
  items.length > 1 && (
    <nav class="toc" id="toc" aria-label={t.post.toc}>
      <details class="toc-details">
        <summary class="toc-title">{t.post.toc}</summary>
        <ul class="toc-list">
          {tree.map(({ heading, children }) => (
            <li class:list={['toc-item', `d${heading.depth}`]}>
              <a href={withBase(`#${heading.slug}`)} data-slug={heading.slug}>
                {heading.text}
              </a>
              {children.length > 0 && (
                <ul class="toc-children">
                  {children.map((child) => (
                    <li class:list={['toc-item', `d${child.depth}`]}>
                      <a href={withBase(`#${child.slug}`)} data-slug={child.slug}>
                        {child.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<style>
  .toc {
    max-width: var(--max-w-prose);
    margin: 0 auto 2rem;
  }
  .toc-details {
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
    padding: 0.5rem 1rem;
    background: var(--paper-2);
  }
  .toc-title {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .toc-title::before {
    content: '▸';
    color: var(--marker);
    transition: transform 0.15s ease;
  }
  .toc-details[open] .toc-title::before {
    transform: rotate(90deg);
  }
  .toc-list,
  .toc-children {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list {
    position: relative;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .toc-children {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.1rem;
  }
  .toc-item a {
    display: block;
    padding: 0.1rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--pencil-60);
    font-size: 0.95rem;
    line-height: 1.5;
    transition: all 0.12s ease;
  }
  .toc-item.d3 a {
    padding-left: 1.4rem;
    font-size: 0.88rem;
  }
  .toc-item a:hover {
    color: var(--pencil);
  }
  .toc-item a.is-active {
    color: var(--marker);
    border-left-color: var(--marker);
    transform: translateX(2px);
  }
  .toc-item.is-current > a {
    color: var(--pencil);
  }

  /* 宽屏：贴到正文左侧页边，sticky 跟随 */
  @media (min-width: 1200px) {
    .toc {
      position: sticky;
      top: 5.5rem;
      float: left;
      width: 12rem;
      margin: 0 0 0 calc((100% - var(--max-w-prose)) / 2 - 12rem - 2rem);
      z-index: 1;
    }
    .toc-details {
      border: 0;
      background: transparent;
      padding: 0;
    }
    .toc-title {
      pointer-events: none;
      font-size: 0.85rem;
      color: var(--pencil-45);
      letter-spacing: 0.1em;
    }
    .toc-title::before {
      display: none;
    }
    .toc-list {
      border-left: 2px dashed var(--pencil-25);
      /* 放不下时目录自身滚动，脚本会把当前条目保持在可见范围内 */
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--pencil-25) transparent;
    }
    .toc-item a {
      margin-left: -2px;
    }
    /* 目录过长：只展开当前章节的子目录 */
    .toc.is-compact .toc-children {
      display: none;
    }
    .toc.is-compact .toc-item.is-current > .toc-children {
      display: flex;
    }
    .toc.is-compact .toc-item.d2:has(.toc-children) > a::after {
      content: ' ▸';
      font-size: 0.7em;
      color: var(--pencil-45);
    }
    .toc.is-compact .toc-item.d2.is-current:has(.toc-children) > a::after {
      content: ' ▾';
    }
  }
</style>

<script>
  let lifecycle: AbortController | undefined;
  function initToc() {
    const toc = document.getElementById('toc');
    if (!toc || toc.dataset.bound) return;
    toc.dataset.bound = '1';
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;
    document.addEventListener('astro:before-swap', () => lifecycle?.abort(), { once: true, signal });
    const list = toc.querySelector<HTMLElement>('.toc-list');
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]')];
    const heads = links
      .map((a) => document.getElementById(a.dataset.slug!))
      .filter((h): h is HTMLElement => !!h);
    if (!list || heads.length === 0) return;

    // 宽屏默认展开
    const details = toc.querySelector<HTMLDetailsElement>('details');
    const wide = window.matchMedia('(min-width: 1200px)');
    const syncOpen = () => {
      if (details) details.open = wide.matches;
    };
    syncOpen();
    wide.addEventListener('change', syncOpen, { signal });

    // 宽屏下整份目录放不下视口时进入紧凑模式：只展开当前章节的子目录。
    const measure = () => {
      toc.classList.remove('is-compact');
      if (!wide.matches) return;
      const available = window.innerHeight - list.getBoundingClientRect().top - 32;
      if (list.scrollHeight > available) toc.classList.add('is-compact');
    };

    let current = '';
    const setActive = (slug: string, force = false) => {
      if (slug === current && !force) return;
      current = slug;
      let active: HTMLAnchorElement | undefined;
      links.forEach((a) => {
        const on = a.dataset.slug === slug;
        a.classList.toggle('is-active', on);
        if (on) active = a;
      });
      const section = active?.closest('.toc-item.d2') ?? active?.closest('.toc-item');
      toc.querySelectorAll('.toc-item.is-current').forEach((item) => item.classList.toggle('is-current', item === section));
      section?.classList.add('is-current');
      // 目录仍然放不下时，随页面滚动把当前条目滚到目录中间。
      if (active && list.scrollHeight > list.clientHeight + 1) {
        list.scrollTop = active.offsetTop - list.clientHeight / 2 + active.offsetHeight / 2;
      }
    };
    // 取视口顶部（留出 sticky 导航栏高度）以上最近的一个标题作为当前章节。
    // 用 getBoundingClientRect 而非 offsetTop：后者相对定位父元素，容器一旦 relative 就会算错。
    const LINE = 120;
    const update = () => {
      let active = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= LINE) active = h;
        else break;
      }
      // 滚到底时高亮最后一个
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        active = heads[heads.length - 1];
      }
      setActive(active.id);
    };
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { measure(); setActive(current, true); }, 120);
    }, { signal });
    window.addEventListener('scroll', update, { passive: true, signal });
    measure();
    update();
    setActive(current, true);
  }
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
