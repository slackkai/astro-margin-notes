---
import { withBase } from '../utils/url';
import { t } from '../i18n';
/**
 * 文章目录：宽屏时贴在左侧页边，随滚动高亮当前章节；窄屏折叠为可展开块。
 * 三级结构：顶层取正文里最高一级的标题（多数文章是 h2，用 h1 分节的文章则是 h1），
 * 下面再挂两级。宽屏下目录放不下时按顺序折叠低级标题——先收起第三级，仍放不下再收起第二级，
 * 当前章节所在的分支始终展开；折叠后仍放不下则目录自身滚动，并随页面滚动保持当前条目可见。
 * 用法：const { headings } = await render(post); <Toc headings={headings} />
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  minDepth?: number;
  maxDepth?: number;
}
type Node = { heading: Heading; children: Node[] };
const topDepth = Math.max(1, Math.min(2, ...Astro.props.headings.map((h) => h.depth)));
const { headings, minDepth = topDepth, maxDepth = minDepth + 2 } = Astro.props;
const items = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
// 按标题层级建树；跳级的标题挂在最近的上一级下面。
const tree: Node[] = [];
const stack: Node[] = [];
for (const heading of items) {
  const node: Node = { heading, children: [] };
  while (stack.length > 0 && stack[stack.length - 1].heading.depth >= heading.depth) stack.pop();
  (stack.length > 0 ? stack[stack.length - 1].children : tree).push(node);
  stack.push(node);
}
const escape = (value: string) => value.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const renderList = (nodes: Node[], level: number): string =>
  `<ul class="${level === 1 ? 'toc-list' : `toc-children l${level}`}">` +
  nodes.map((node) =>
    `<li class="toc-item d${level}"><a href="${escape(withBase(`#${node.heading.slug}`))}" data-slug="${escape(node.heading.slug)}">${escape(node.heading.text)}</a>` +
    (node.children.length > 0 ? renderList(node.children, level + 1) : '') + '</li>').join('') +
  '</ul>';
---

{
  items.length > 1 && (
    <nav class="toc" id="toc" aria-label={t.post.toc}>
      <details class="toc-details">
        <summary class="toc-title">{t.post.toc}</summary>
        <Fragment set:html={renderList(tree, 1)} />
      </details>
    </nav>
  )
}

<style is:global>
  @property --fade-top {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }
  @property --fade-bottom {
    syntax: '<length>';
    inherits: false;
    initial-value: 0rem;
  }
  .toc {
    max-width: var(--max-w-prose);
    margin: 0 auto 2rem;
  }
  .toc-details {
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
    padding: 0.5rem 1rem;
    background: var(--paper-2);
  }
  .toc-title {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .toc-title::before {
    content: '▸';
    color: var(--marker);
    transition: transform 0.15s ease;
  }
  .toc-details[open] .toc-title::before {
    transform: rotate(90deg);
  }
  .toc-list,
  .toc-children {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .toc-list {
    position: relative;
    margin-top: 0.5rem;
  }
  .toc-children {
    margin-top: 0.15rem;
  }
  .toc-item a {
    display: block;
    padding: 0.1rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--pencil-60);
    font-size: 0.95rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .toc-item.d2 a {
    padding-left: 1.2rem;
    font-size: 0.88rem;
  }
  .toc-item.d3 a {
    padding-left: 1.9rem;
    font-size: 0.82rem;
  }
  .toc-item a:hover {
    color: var(--pencil);
  }
  .toc-item a.is-active {
    color: var(--marker);
    border-left-color: var(--marker);
  }
  .toc-item.is-current > a {
    color: var(--pencil);
  }

  /* 宽屏：贴到正文左侧页边，sticky 跟随 */
  @media (min-width: 1200px) {
    .toc {
      position: sticky;
      top: 5.5rem;
      float: left;
      width: 12rem;
      margin: 0 0 0 calc((100% - var(--max-w-prose)) / 2 - 12rem - 2rem);
      z-index: 1;
    }
    .toc-details {
      border: 0;
      background: transparent;
      padding: 0;
    }
    .toc-title {
      pointer-events: none;
      font-size: 0.85rem;
      color: var(--pencil-45);
      letter-spacing: 0.1em;
    }
    .toc-title::before {
      display: none;
    }
    .toc-list {
      border-left: 2px dashed var(--pencil-25);
      /* 折叠后仍放不下时目录自身滚动；不显示滚动条，脚本随页面滚动保持当前条目可见 */
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .toc-list::-webkit-scrollbar {
      display: none;
    }
    /* 只在还有被遮住内容的一侧淡出：滚到顶或底时，第一条、最后一条完整显示 */
    .toc-list {
      --fade-top: 0rem;
      --fade-bottom: 0rem;
      scroll-behavior: smooth;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
      transition: --fade-top 0.2s ease, --fade-bottom 0.2s ease;
    }
    .toc-list.is-clipped-top {
      --fade-top: 1.5rem;
    }
    .toc-list.is-clipped-bottom {
      --fade-bottom: 1.5rem;
    }
    .toc-item a {
      margin-left: -2px;
    }
    /* 目录过长：先收起第三级，再收起第二级；当前章节所在分支保持展开 */
    .toc.is-fold-3 .toc-children.l3,
    .toc.is-fold-2 .toc-children.l2 {
      display: none;
    }
    .toc.is-fold-3 .toc-item.is-current > .toc-children.l3,
    .toc.is-fold-2 .toc-item.is-current > .toc-children.l2 {
      display: flex;
    }
    .toc.is-fold-3 .toc-item.d2:has(> .toc-children):not(.is-current) > a::after,
    .toc.is-fold-2 .toc-item.d1:has(> .toc-children):not(.is-current) > a::after {
      content: ' ▸';
      font-size: 0.7em;
      color: var(--pencil-45);
    }
  }
</style>

<script>
  let lifecycle: AbortController | undefined;
  function initToc() {
    const toc = document.getElementById('toc');
    if (!toc || toc.dataset.bound) return;
    toc.dataset.bound = '1';
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;
    document.addEventListener('astro:before-swap', () => lifecycle?.abort(), { once: true, signal });
    const list = toc.querySelector<HTMLElement>('.toc-list');
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]')];
    const heads = links
      .map((a) => document.getElementById(a.dataset.slug!))
      .filter((h): h is HTMLElement => !!h);
    if (!list || heads.length === 0) return;

    // 宽屏默认展开
    const details = toc.querySelector<HTMLDetailsElement>('details');
    const wide = window.matchMedia('(min-width: 1200px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncOpen = () => {
      if (details) details.open = wide.matches;
    };
    syncOpen();
    wide.addEventListener('change', syncOpen, { signal });

    // 按目录自身的滚动位置决定哪一侧淡出。
    const edges = () => {
      const max = list.scrollHeight - list.clientHeight;
      list.classList.toggle('is-clipped-top', max > 1 && list.scrollTop > 1);
      list.classList.toggle('is-clipped-bottom', max > 1 && list.scrollTop < max - 1);
    };
    list.addEventListener('scroll', edges, { passive: true, signal });
    // 目录仍然放不下时，随页面滚动把当前条目滚到目录中间。
    const follow = () => {
      const active = list.querySelector<HTMLElement>('a.is-active');
      if (active && list.scrollHeight > list.clientHeight + 1) {
        const max = list.scrollHeight - list.clientHeight;
        const top = Math.max(0, Math.min(max, active.offsetTop - list.clientHeight / 2 + active.offsetHeight / 2));
        if (Math.abs(top - list.scrollTop) > 1) list.scrollTo({ top, behavior: reduced.matches ? 'auto' : 'smooth' });
      }
      edges();
    };
    // 宽屏下整份目录放不下视口时按顺序折叠：先第三级，再第二级；当前分支保持展开。
    const fit = () => {
      toc.classList.remove('is-fold-2', 'is-fold-3');
      if (wide.matches) {
        const available = () => window.innerHeight - list.getBoundingClientRect().top - 32;
        if (list.scrollHeight > available()) toc.classList.add('is-fold-3');
        if (list.scrollHeight > available()) toc.classList.add('is-fold-2');
      }
      follow();
    };

    let current = '';
    const setActive = (slug: string) => {
      if (slug === current) return;
      current = slug;
      toc.querySelectorAll('.is-current').forEach((item) => item.classList.remove('is-current'));
      for (const a of links) {
        const on = a.dataset.slug === slug;
        a.classList.toggle('is-active', on);
        if (!on) continue;
        // 当前条目的每一级祖先都标记为当前分支，这样折叠时它们的子目录保持展开。
        let item = a.parentElement;
        while (item && item !== list) {
          if (item.classList.contains('toc-item')) item.classList.add('is-current');
          item = item.parentElement;
        }
      }
      fit();
    };
    // 取视口顶部（留出 sticky 导航栏高度）以上最近的一个标题作为当前章节。
    // 用 getBoundingClientRect 而非 offsetTop：后者相对定位父元素，容器一旦 relative 就会算错。
    const LINE = 120;
    const update = () => {
      let active = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= LINE) active = h;
        else break;
      }
      // 滚到底时高亮最后一个
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        active = heads[heads.length - 1];
      }
      setActive(active.id);
    };
    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(fit, 120);
    }, { signal });
    // 每帧最多计算一次当前章节
    let frame = 0;
    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(() => { frame = 0; update(); });
    }, { passive: true, signal });
    signal.addEventListener('abort', () => cancelAnimationFrame(frame));
    update();
  }
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
