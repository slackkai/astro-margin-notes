---
/**
 * 阅读进度：页面右侧一条竖向轨道，填充随滚动下移，小圆钮标出当前位置。
 * 可拖动：拖圆钮或点轨道任意位置会滚到对应进度。仅在 ≥900px 显示。
 */
---

<div class="read-progress" id="read-progress" data-pagefind-ignore role="slider" aria-label="阅读进度" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
  <div class="read-progress-hit" id="read-progress-hit"></div>
  <div class="read-progress-fill" id="read-progress-fill"></div>
  <div class="read-progress-knob" id="read-progress-knob"></div>
  <span class="read-progress-label" id="read-progress-label">0%</span>
</div>

<script>
  let lifecycle: AbortController | undefined;
  function initProgress() {
    const root = document.getElementById('read-progress');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;
    document.addEventListener("astro:before-swap", () => lifecycle?.abort(), { once: true, signal });
    const fill = document.getElementById('read-progress-fill');
    const knob = document.getElementById('read-progress-knob');
    const label = document.getElementById('read-progress-label');
    const hit = document.getElementById('read-progress-hit');
    if (!fill || !knob || !label || !hit) return;
    const rootEl = root, fillEl = fill, knobEl = knob, labelEl = label, hitEl = hit;

    const maxScroll = () => document.documentElement.scrollHeight - window.innerHeight;
    const render = () => {
      const max = maxScroll();
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      fillEl.style.transform = `scaleY(${p})`;
      knobEl.style.top = `${p * 100}%`;
      labelEl.style.top = `${p * 100}%`;
      labelEl.textContent = `${Math.round(p * 100)}%`;
      rootEl.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    };

    // 拖动 / 点击轨道 → 滚动
    let dragging = false;
    const ratioFromY = (clientY: number) => {
      const r = rootEl.getBoundingClientRect();
      return Math.min(1, Math.max(0, (clientY - r.top) / r.height));
    };
    const scrollToRatio = (p: number) => {
      window.scrollTo({ top: p * maxScroll(), behavior: 'auto' });
    };
    const onDown = (e: PointerEvent) => {
      dragging = true;
      rootEl.classList.add('is-dragging');
      document.documentElement.style.scrollBehavior = 'auto';
      hitEl.setPointerCapture(e.pointerId);
      scrollToRatio(ratioFromY(e.clientY));
      e.preventDefault();
    };
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      scrollToRatio(ratioFromY(e.clientY));
    };
    const onUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      rootEl.classList.remove('is-dragging');
      document.documentElement.style.scrollBehavior = '';
      hitEl.releasePointerCapture(e.pointerId);
    };
    hitEl.addEventListener('pointerdown', onDown);
    hitEl.addEventListener('pointermove', onMove);
    hitEl.addEventListener('pointerup', onUp);
    hitEl.addEventListener('pointercancel', onUp);

    // 键盘：上下键 / PageUp / PageDown / Home / End
    rootEl.addEventListener('keydown', (e) => {
      const step = window.innerHeight * 0.1;
      const map: Record<string, number | 'home' | 'end'> = {
        ArrowDown: step,
        ArrowUp: -step,
        PageDown: window.innerHeight * 0.8,
        PageUp: -window.innerHeight * 0.8,
        Home: 'home',
        End: 'end',
      };
      const d = map[e.key];
      if (d === undefined) return;
      e.preventDefault();
      if (d === 'home') window.scrollTo({ top: 0 });
      else if (d === 'end') window.scrollTo({ top: maxScroll() });
      else window.scrollBy({ top: d });
    });

    window.addEventListener('scroll', render, { passive: true, signal });
    window.addEventListener('resize', render, { signal });
    render();
  }
  initProgress();
  document.addEventListener('astro:page-load', initProgress);
</script>
