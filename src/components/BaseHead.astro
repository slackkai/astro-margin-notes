---
import { withBase } from '../utils/url';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description = SITE.description, image, type = 'website', publishedTime } = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\/404\/$/, '/404.html'), Astro.site);
const ogImage = image ? new URL(withBase(image), Astro.site) : undefined;

// 文楷 Screen 中包含基本拉丁字母与常用标点的子集块，预加载它让首屏英文/数字尽早就位
import latinChunk from 'lxgw-wenkai-screen-webfont/files/lxgwwenkaiscreen-subset-119.woff2?url';
const FONTS = [latinChunk];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
{type === 'article' && <meta name="giscus:backlink" content={canonical} />}
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL(withBase('/rss.xml'), Astro.site)} />

{FONTS.map((href) => <link rel="preload" as="font" type="font/woff2" href={withBase(href)} crossorigin />)}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script is:inline>
  // 首屏前设置主题与配色，避免闪烁；切页时把两者带到新文档上
  (function () {
    const PALETTES = ['blue', 'classic', 'green', 'mono'];
    const read = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
    const getTheme = () => {
      const saved = read('theme');
      return ['dark', 'light'].includes(saved) ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    };
    const getPalette = () => {
      const p = read('palette');
      return p && PALETTES.includes(p) ? p : (document.documentElement.dataset.defaultPalette || 'blue');
    };
    const apply = (root) => {
      root.setAttribute('data-theme', getTheme());
      root.setAttribute('data-palette', getPalette());
    };
    apply(document.documentElement);
    document.addEventListener('astro:before-swap', (e) => apply(e.newDocument.documentElement));
  })();
</script>
