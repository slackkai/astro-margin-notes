---
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description = SITE.description, image, type = 'website', publishedTime } = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;

const FONTS = [
  '/fonts/patrick-hand-latin-400-normal.woff2',
  '/fonts/kalam-latin-400-normal.woff2',
  '/fonts/kalam-latin-700-normal.woff2',
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />

{FONTS.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script is:inline>
  // 首屏前设置主题，避免闪烁；切页时把主题带到新文档上
  (function () {
    const getTheme = () =>
      localStorage.getItem('theme') ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', getTheme());
    document.addEventListener('astro:before-swap', (e) => {
      e.newDocument.documentElement.setAttribute('data-theme', getTheme());
    });
  })();
</script>
