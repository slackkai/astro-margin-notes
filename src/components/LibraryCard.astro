---
import { withBase } from '../utils/url';
/**
 * 资料库卡片：书 / 论文 / 工具 / 链接
 */
import Tags from './Tags.astro';
import { t } from '../i18n';

interface Props {
  href: string;
  title: string;
  type: string;
  url?: string;
  author?: string;
  rating?: number;
  status?: string;
  summary?: string;
  cover?: string;
  tags?: string[];
  rotate?: number;
  index?: number;
  transitionName?: string;
}
const { href, title, type, url, author, rating, status, summary, cover, tags = [], rotate = 0, index = 0, transitionName } =
  Astro.props;
const typeLabel = `${t.library.typeEmoji[type] ?? t.library.typeEmoji.other} ${t.library.types[type] ?? t.library.types.other}`;
---

<article class="hand-card lib-card reveal" style={`--r:${rotate}deg; --i:${index}`}>
  <svg class="clip" viewBox="0 0 24 48" aria-hidden="true">
    <path d="M8 44 V10 a4 4 0 0 1 8 0 V38 a2 2 0 0 1 -4 0 V14" />
  </svg>
  {cover && <img class="lib-cover" src={withBase(cover)} alt="" loading="lazy" decoding="async" />}
  <div class="lib-body">
    <div class="lib-top">
      <span class="lib-type">{typeLabel}</span>
      {status && <span class="lib-status">{t.library.status[status] ?? status}</span>}
    </div>
    <h3 class="lib-title" transition:name={transitionName}><a href={withBase(href)}>{title}</a></h3>
    {author && <p class="meta lib-author">{author}</p>}
    {
      rating && (
        <p class="lib-rating" aria-label={t.library.rating(rating)}>
          {'★'.repeat(rating)}
          <span class="dim">{'★'.repeat(5 - rating)}</span>
        </p>
      )
    }
    {summary && <p class="lib-summary">{summary}</p>}
    <div class="lib-foot">
      {tags.length > 0 && <Tags tags={tags} small />}
      {
        url && (
          <a href={withBase(url)} target="_blank" rel="noopener" class="hand-btn small">
            {t.common.open}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .lib-card {
    display: flex;
    flex-direction: column;
    overflow: visible;
    transform: rotate(var(--r));
    height: 100%;
  }
  .lib-card:hover {
    transform: rotate(calc(var(--r) - 0.6deg)) translate(-1px, -1px);
    box-shadow: var(--shadow-hand);
  }
  .lib-cover {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-bottom: 2px solid var(--pencil);
    border-radius: 200px 12px 0 0 / 12px 200px 0 0;
  }
  .lib-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.2rem 1.1rem;
    flex: 1;
  }
  .lib-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .lib-type {
    color: var(--pencil-60);
  }
  .lib-status {
    padding: 0 0.5rem;
    border: 2px solid var(--pencil);
    border-radius: var(--radius-wobble-sm);
    background: var(--postit-2);
    color: var(--pencil);
    font-weight: 700;
  }
  .lib-title {
    font-size: 1.3rem;
  }
  .lib-title a:hover {
    color: var(--marker);
  }
  .lib-author {
    margin: 0;
  }
  .lib-rating {
    margin: 0;
    color: var(--marker);
    letter-spacing: 0.1em;
    font-size: 0.95rem;
  }
  .lib-rating .dim {
    color: var(--pencil-25);
  }
  .lib-summary {
    margin: 0;
    color: var(--pencil-60);
    font-size: 1rem;
  }
  .lib-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
</style>
