---
/**
 * 归档列表：按年 / 月，一行一条。
 */
import { SECTIONS, type SectionKey } from '../consts';
import { getArchive, entryHref, formatDate } from '../utils/content';

const years = await getArchive();
const label = (c: string) => (c in SECTIONS ? SECTIONS[c as SectionKey] : { emoji: '🛠️', label: 'Project' });
let total = 0;
for (const months of years.values()) for (const list of months.values()) total += list.length;
---

<div class="archive">
  <p class="meta">共 {total} 条</p>
  {
    [...years.entries()].map(([y, months]) => (
      <section class="arch-year" id={`y${y}`}>
        <h2 class="arch-year-label">{y}</h2>
        {[...months.entries()].map(([m, list]) => (
          <div class="arch-month" id={`m${y}-${String(m).padStart(2, '0')}`}>
            <h3 class="arch-month-label">
              <span class="postit blue">{m} 月</span>
            </h3>
            <ul class="arch-list">
              {list.map((e) => (
                <li class="arch-row">
                  <time class="meta">{formatDate(e.data.date, 'short')}</time>
                  <span class="arch-sec" title={label(e.collection).label}>
                    {label(e.collection).emoji}
                  </span>
                  <a href={entryHref(e)}>{'title' in e.data && e.data.title ? e.data.title : formatDate(e.data.date)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</div>

<style>
  .archive {
    max-width: 44rem;
  }
  .arch-year {
    margin-top: 2rem;
  }
  .arch-year-label {
    font-size: 2.2rem;
    color: var(--marker);
    transform: rotate(-2deg);
    transform-origin: left bottom;
    margin-bottom: 0.5rem;
  }
  .arch-month {
    margin: 1rem 0 1.5rem;
  }
  .arch-month-label {
    margin-bottom: 0.6rem;
  }
  .arch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px dashed var(--pencil-25);
    margin-left: 0.6rem;
    padding-left: 1rem;
  }
  .arch-row {
    display: grid;
    grid-template-columns: 3.2rem 1.6rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-wobble-sm);
    transition: background 0.12s ease;
  }
  .arch-row:hover {
    background: var(--postit);
  }
  .arch-row a:hover {
    color: var(--marker);
  }
</style>
