---
/**
 * 页脚结束语：从 consts.SIGNOFFS 里随机抽一句，每次加载不同。
 */
import { SIGNOFFS } from '../consts';
---

<p class="signoff" id="site-signoff" data-lines={JSON.stringify(SIGNOFFS)}>
  <span class="signoff-dash" aria-hidden="true">—</span>
  <span class="signoff-text">{SIGNOFFS[0]}</span>
</p>

<style>
  .signoff {
    margin: 0 0 1rem;
    font-size: 1rem;
    color: var(--pencil-60);
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .signoff-dash {
    color: var(--marker);
  }
  .signoff-text {
    display: inline-block;
    transform: rotate(-0.8deg);
    animation: fade-up 0.4s ease-out both;
  }
</style>

<script>
  function initSignoff() {
    const el = document.getElementById('site-signoff');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';
    const text = el.querySelector<HTMLElement>('.signoff-text');
    const lines: string[] = JSON.parse(el.dataset.lines ?? '[]');
    if (!text || lines.length === 0) return;
    text.textContent = lines[Math.floor(Math.random() * lines.length)];
  }
  initSignoff();
  document.addEventListener('astro:page-load', initSignoff);
</script>
