---
/**
 * 配色切换：右上角按钮 + 下拉面板，选择保存在 localStorage('palette')，
 * 首屏由 BaseHead 的内联脚本应用，避免闪烁。
 */
const PALETTES = [
  { id: 'blue', name: '靛蓝 × 赭石', swatches: ['#f6f7f4', '#1f2433', '#c4562f', '#3b4f9e', '#e6ebfa'] },
  { id: 'classic', name: '纸黄 × 红笔', swatches: ['#fdfbf7', '#2d2d2d', '#ff4d4d', '#2d5da1', '#fff9c4'] },
  { id: 'green', name: '墨绿 × 橙', swatches: ['#f7f4ec', '#23302a', '#e8962e', '#2f6b4f', '#fbe9c7'] },
  { id: 'mono', name: '炭黑 × 紫红', swatches: ['#f3f1ed', '#1c1b19', '#b8336a', '#1c1b19', '#f6dde7'] },
];
---

<div class="pal-wrap" id="pal-wrap">
  <button class="pal-btn" id="pal-btn" aria-label="切换配色" title="配色" aria-haspopup="true" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 1.5-2s0-2 1.5-2h2a4 4 0 0 0 4-4 10 10 0 0 0-9-10z" />
      <circle cx="7.5" cy="11" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="10.5" cy="7" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="15" cy="7.5" r="1.3" fill="currentColor" stroke="none" />
    </svg>
  </button>
  <div class="pal-menu" id="pal-menu" hidden role="menu">
    {
      PALETTES.map((p) => (
        <button class="pal-item" role="menuitemradio" data-palette={p.id} aria-checked="false">
          <span class="swatches" aria-hidden="true">
            {p.swatches.map((c) => (
              <i style={`background:${c}`} />
            ))}
          </span>
          <span>{p.name}</span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .pal-wrap {
    position: relative;
  }
  .pal-btn {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 2px solid var(--pencil);
    border-radius: var(--radius-wobble-sm);
    background: var(--paper-2);
    box-shadow: var(--shadow-hand-sm);
    transition: all 0.1s ease;
  }
  .pal-btn:hover,
  .pal-btn[aria-expanded='true'] {
    background: var(--postit);
    transform: rotate(6deg);
  }
  .pal-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 12rem;
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--paper-2);
    border: 2px solid var(--pencil);
    border-radius: var(--radius-wobble-sm);
    box-shadow: var(--shadow-hand);
    z-index: 70;
    animation: fade-up 0.18s ease-out;
  }
  .pal-menu[hidden] {
    display: none;
  }
  .pal-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.6rem;
    border: 2px solid transparent;
    border-radius: var(--radius-wobble-sm);
    font-size: 0.95rem;
    text-align: left;
    white-space: nowrap;
  }
  .pal-item:hover {
    border-color: var(--pencil);
  }
  .pal-item[aria-checked='true'] {
    background: var(--postit);
    border-color: var(--pencil);
  }
  .swatches {
    display: inline-flex;
    gap: 2px;
  }
  .swatches i {
    width: 0.7rem;
    height: 0.9rem;
    border: 1.5px solid var(--pencil);
    border-radius: 3px 5px 4px 5px / 5px 4px 5px 3px;
  }
</style>

<script>
  function initPalette() {
    const btn = document.getElementById('pal-btn');
    const menu = document.getElementById('pal-menu');
    if (!btn || !menu || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    const btnEl = btn, menuEl = menu;
    const items = menuEl.querySelectorAll<HTMLButtonElement>('[data-palette]');

    const sync = () => {
      const cur = document.documentElement.getAttribute('data-palette') ?? 'blue';
      items.forEach((it) => it.setAttribute('aria-checked', String(it.dataset.palette === cur)));
    };
    const close = () => {
      menuEl.hidden = true;
      btnEl.setAttribute('aria-expanded', 'false');
    };
    btnEl.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menuEl.hidden;
      menuEl.hidden = !open;
      btnEl.setAttribute('aria-expanded', String(open));
      if (open) sync();
    });
    items.forEach((it) =>
      it.addEventListener('click', () => {
        const id = it.dataset.palette!;
        document.documentElement.setAttribute('data-palette', id);
        localStorage.setItem('palette', id);
        sync();
        close();
      }),
    );
    document.addEventListener('click', (e) => {
      if (!menuEl.hidden && !menuEl.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
  initPalette();
  document.addEventListener('astro:page-load', initPalette);
</script>
