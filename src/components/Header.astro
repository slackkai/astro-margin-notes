---
import { withBase } from '../utils/url';
import { NAV, SITE, config } from '../config';
import { t } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';
import PaletteToggle from './PaletteToggle.astro';
import Search from './Search.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === withBase('/') : path.startsWith(withBase(href)));
const mark = SITE.title.trim().charAt(0).toUpperCase() || '•';
---

<header class="site-header" data-auto-hide={String(config.interactions.autoHideHeader)} data-pagefind-ignore>
  <div class="container header-inner">
    <a href={withBase('/')} class="brand" aria-label={SITE.title}>
      <span class="brand-mark" aria-hidden="true">{mark}</span>
      <span class="brand-text">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label={t.common.mainNav}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {config.features.search && <Search />}
      {config.features.paletteSwitcher && <PaletteToggle />}
      <ThemeToggle />
      <button class="menu-btn" id="menu-btn" aria-label={t.common.openMenu} aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label={t.common.mobileNav}>
    <ul class="container">
      {
        NAV.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 2px dashed var(--pencil-25);
    transition: transform 180ms ease;
  }
  .site-header.is-hidden:not(:has(:focus-visible)) {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.35rem;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 2px solid var(--pencil);
    border-radius: var(--radius-wobble-sm);
    background: var(--postit);
    color: var(--pencil);
    box-shadow: var(--shadow-hand-sm);
    transform: rotate(-4deg);
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .brand-text {
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .brand-text { display: none; }
  }
  .brand:hover .brand-mark {
    transform: rotate(8deg) scale(1.08);
  }
  .nav {
    display: none;
  }
  .nav ul,
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }
  .nav-link {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 2px solid transparent;
    border-radius: var(--radius-wobble-sm);
    font-size: 1.05rem;
    transition: all 0.12s ease;
  }
  .nav-link:hover {
    border-color: var(--pencil);
    background: var(--paper-2);
    transform: translateY(-1px);
  }
  .nav-link.active {
    border-color: var(--pencil);
    background: var(--postit);
    color: var(--pencil);
    box-shadow: var(--shadow-hand-sm);
    transform: rotate(-1.5deg);
  }
  .nav-link.active:hover {
    animation: wiggle 0.35s ease-in-out;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 2px solid var(--pencil);
    border-radius: var(--radius-wobble-sm);
    background: var(--paper-2);
    box-shadow: var(--shadow-hand-sm);
    transition: transform 0.1s ease;
  }
  .menu-btn[aria-expanded='true'] {
    background: var(--postit);
    color: var(--pencil);
    transform: rotate(90deg);
  }
  .mobile-nav ul {
    flex-direction: column;
    gap: 0.4rem;
    padding-block: 0.75rem 1rem;
  }
  .mobile-nav:not([hidden]) li {
    animation: fade-up 0.3s both;
    animation-delay: calc(var(--i, 0) * 40ms);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  @media (min-width: 1200px) {
    .nav {
      display: block;
    }
    .menu-btn,
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  let disposeHeader: (() => void) | undefined;
  function bindMenu() {
    disposeHeader?.();
    const header = document.querySelector<HTMLElement>('.site-header');
    const btn = document.getElementById('menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!header || !btn || !nav) return;
    const controller = new AbortController();
    const { signal } = controller;
    let frame = 0;
    let lastY = Math.max(0, window.scrollY);
    let direction = 0;
    let travel = 0;
    const show = () => header.classList.remove('is-hidden');
    const closeMenu = () => {
      nav.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    const update = () => {
      frame = 0;
      // Clamp elastic overscroll so bouncing at the bottom cannot reverse direction.
      const max = Math.max(0, document.documentElement.scrollHeight - innerHeight);
      const y = Math.max(0, Math.min(window.scrollY, max));
      const delta = y - lastY;
      lastY = y;
      const locked = header.querySelector(':focus-visible') ||
        header.querySelector('[aria-expanded="true"], dialog[open]');
      if (y <= header.offsetHeight || locked || header.dataset.autoHide !== 'true') {
        show(); travel = 0; direction = 0; return;
      }
      if (!delta) return;
      const next = Math.sign(delta);
      travel = next === direction ? travel + Math.abs(delta) : Math.abs(delta);
      direction = next;
      if (travel >= 10) header.classList.toggle('is-hidden', direction > 0);
    };
    show();
    nav.querySelectorAll('li').forEach((li, i) => li.style.setProperty('--i', String(i)));
    btn.addEventListener('click', () => {
      const open = nav.hidden;
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      show();
    }, { signal });
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) closeMenu();
    }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !nav.hidden) { closeMenu(); btn.focus(); }
    }, { signal });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) closeMenu();
    }, { signal });
    const wide = matchMedia('(min-width: 1200px)');
    wide.addEventListener('change', () => { if (wide.matches) closeMenu(); }, { signal });
    header.addEventListener('focusin', (event) => {
      if ((event.target as Element).matches(':focus-visible')) show();
    }, { signal });
    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(update);
    }, { passive: true, signal });
    disposeHeader = () => { controller.abort(); cancelAnimationFrame(frame); };
  }
  bindMenu();
  document.addEventListener('astro:before-swap', () => disposeHeader?.());
  document.addEventListener('astro:page-load', bindMenu);
</script>
