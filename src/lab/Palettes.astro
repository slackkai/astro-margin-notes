---
/**
 * 原型 4：配色切换。按钮改变 #lab 的 data-palette，整页原型一起换色。
 */
const palettes = [
  { id: 'current', name: '现状', desc: '纸黄 · 红笔 · 蓝笔', swatches: ['#fdfbf7', '#2d2d2d', '#ff4d4d', '#2d5da1', '#fff9c4'] },
  { id: 'green', name: '墨绿 × 橙', desc: '图书馆、旧笔记本', swatches: ['#f7f4ec', '#23302a', '#e8962e', '#2f6b4f', '#fbe9c7'] },
  { id: 'blue', name: '靛蓝 × 赭石', desc: '实验室、蓝图', swatches: ['#f6f7f4', '#1f2433', '#c4562f', '#3b4f9e', '#e6ebfa'] },
  { id: 'mono', name: '炭黑 × 紫红', desc: '素描本、单色钢笔', swatches: ['#f3f1ed', '#1c1b19', '#b8336a', '#1c1b19', '#f6dde7'] },
];
---

<div class="palettes" id="palettes">
  {
    palettes.map((p) => (
      <button class="hand-card pal" data-palette={p.id}>
        <span class="swatches">
          {p.swatches.map((c) => (
            <i style={`background:${c}`} />
          ))}
        </span>
        <strong>{p.name}</strong>
        <span class="muted">{p.desc}</span>
      </button>
    ))
  }
</div>
<p class="meta" style="margin-top:1rem">色块顺序：纸 · 文字 · 强调 · 链接 · 便签。</p>

<style>
  .palettes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .pal {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    text-align: left;
    cursor: pointer;
  }
  .pal.is-on {
    box-shadow: var(--shadow-hand);
    transform: rotate(-1deg);
  }
  .pal strong {
    font-family: var(--font-heading);
    font-size: 1.1rem;
  }
  .swatches {
    display: flex;
    gap: 0.25rem;
  }
  .swatches i {
    flex: 1;
    height: 1.6rem;
    border: 2px solid var(--pencil);
    border-radius: 6px 10px 8px 9px / 9px 8px 10px 6px;
  }
</style>

<script>
  function initPalettes() {
    const wrap = document.getElementById('palettes');
    const lab = document.getElementById('lab');
    if (!wrap || !lab || wrap.dataset.bound) return;
    wrap.dataset.bound = '1';
    const btns = wrap.querySelectorAll<HTMLButtonElement>('[data-palette]');
    const set = (id: string) => {
      lab.setAttribute('data-palette', id);
      btns.forEach((b) => b.classList.toggle('is-on', b.dataset.palette === id));
    };
    btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.palette!)));
    set('current');
  }
  initPalettes();
  document.addEventListener('astro:page-load', initPalettes);
</script>
