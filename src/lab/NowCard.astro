---
/**
 * 原型 5：Now 卡片。"在读"自动来自资料库 status: reading；其余两行先写死，采纳后改为 src/content/now.md。
 */
import { getPosts } from '../utils/content';
const reading = (await getPosts('library')).filter((l) => l.data.status === 'reading').slice(0, 2);
---

<div class="now-wrap">
  <article class="index-card">
    <svg class="clip" viewBox="0 0 24 48" aria-hidden="true">
      <path d="M8 44 V10 a4 4 0 0 1 8 0 V38 a2 2 0 0 1 -4 0 V14" />
    </svg>
    <header>
      <span class="stamp">NOW</span>
      <span class="meta">更新于 2026-09-19</span>
    </header>
    <dl>
      <dt>在做</dt>
      <dd>一个四足机器人的落地控制器，先在 sim 里跑通。</dd>
      <dt>在读</dt>
      <dd>
        {reading.length > 0 ? reading.map((r, i) => (
          <>
            <a href={`/library/${r.id}/`}>{r.data.title}</a>
            {i < reading.length - 1 && '、'}
          </>
        )) : <span class="muted">资料库里还没有「在读」条目</span>}
      </dd>
      <dt>在听</dt>
      <dd>Lex Fridman 和 Sergey Levine 那期。</dd>
    </dl>
  </article>
</div>

<style>
  .now-wrap {
    max-width: 30rem;
  }
  /* 索引卡：横线纸 + 顶部红线 */
  .index-card {
    position: relative;
    padding: 1.25rem 1.5rem 1.25rem;
    background-color: var(--paper-2);
    background-image:
      linear-gradient(transparent 0, transparent calc(100% - 1px), var(--pencil-12) calc(100% - 1px));
    background-size: 100% 1.9rem;
    background-position: 0 3.2rem;
    border: 2px solid var(--pencil);
    border-radius: 8px 14px 10px 12px / 12px 10px 14px 8px;
    box-shadow: var(--shadow-soft);
    transform: rotate(-1.2deg);
  }
  .index-card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 3.1rem;
    border-top: 2px solid color-mix(in srgb, var(--marker) 55%, transparent);
  }
  .clip {
    position: absolute;
    top: -1.1rem;
    left: 1.5rem;
    width: 1.4rem;
    height: 2.8rem;
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(-6deg);
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.9rem;
  }
  .stamp {
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 0.15em;
    padding: 0 0.5rem;
    border: 2px solid var(--marker);
    color: var(--marker);
    border-radius: 4px;
    transform: rotate(-3deg);
    display: inline-block;
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    row-gap: 0.25rem;
    line-height: 1.9rem;
  }
  dt {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--pen);
  }
  dd {
    margin: 0;
  }
  dd a {
    text-decoration: underline wavy;
    text-decoration-color: var(--marker);
    text-underline-offset: 3px;
  }
</style>
