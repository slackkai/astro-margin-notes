---
/**
 * 原型 2：方格纸背景 + 胶带贴角 vs 现状（点阵 + 图钉）
 */
---

<div class="compare">
  <div class="side current">
    <p class="label">现状：点阵 + 图钉</p>
    <div class="hand-card demo">
      <span class="tack" aria-hidden="true"></span>
      <h3>Attention Is All You Need 精读</h3>
      <p class="muted">Transformer 原始论文的结构梳理。</p>
    </div>
  </div>

  <div class="side proposed">
    <p class="label">提案：方格纸 + 胶带</p>
    <div class="hand-card demo taped">
      <h3>Attention Is All You Need 精读</h3>
      <p class="muted">Transformer 原始论文的结构梳理。</p>
    </div>
    <div class="hand-card demo clipped">
      <svg class="clip" viewBox="0 0 24 48" aria-hidden="true">
        <path d="M8 44 V10 a4 4 0 0 1 8 0 V38 a2 2 0 0 1 -4 0 V14" />
      </svg>
      <h3>回形针变体</h3>
      <p class="muted">适合资料库卡片。</p>
    </div>
  </div>
</div>

<style>
  .compare {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .compare {
      grid-template-columns: 1fr 1fr;
    }
  }
  .side {
    padding: 2rem 1.5rem;
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
  }
  .current {
    background-color: var(--paper);
    background-image: radial-gradient(var(--erased) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  /* 方格纸：细线 + 每 5 格一条粗线 */
  .proposed {
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--pencil-12) 1px, transparent 1px),
      linear-gradient(90deg, var(--pencil-12) 1px, transparent 1px),
      linear-gradient(var(--pencil-25) 1.5px, transparent 1.5px),
      linear-gradient(90deg, var(--pencil-25) 1.5px, transparent 1.5px);
    background-size: 24px 24px, 24px 24px, 120px 120px, 120px 120px;
  }
  .label {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .demo {
    padding: 1.6rem 1.25rem 1.1rem;
    margin-bottom: 1.5rem;
  }
  .demo h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }
  .demo p {
    margin: 0;
  }
  /* 胶带贴角 */
  .taped::before,
  .taped::after {
    content: '';
    position: absolute;
    width: 5.5rem;
    height: 1.4rem;
    background: rgba(255, 236, 150, 0.7);
    border: 1px solid rgba(45, 45, 45, 0.15);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(0.5px);
  }
  .taped::before {
    top: -0.6rem;
    left: -1.4rem;
    transform: rotate(-32deg);
  }
  .taped::after {
    bottom: -0.6rem;
    right: -1.4rem;
    transform: rotate(-32deg);
  }
  /* 回形针 */
  .clip {
    position: absolute;
    top: -1.1rem;
    right: 1.5rem;
    width: 1.4rem;
    height: 2.8rem;
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(8deg);
  }
</style>
