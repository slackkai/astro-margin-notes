---
/**
 * 原型 6：404 —— 一台迷路的小机器人，轮子会转，天线上的灯闪。
 */
---

<div class="nf">
  <svg class="bot" viewBox="0 0 200 180" aria-hidden="true">
    <!-- 问号轨迹 -->
    <path class="trail" d="M20 150 q40 -30 70 0 t70 0" stroke-dasharray="6 6" />
    <!-- 身体 -->
    <g class="body">
      <rect x="60" y="70" width="80" height="60" rx="10" fill="var(--paper-2)" />
      <rect x="72" y="84" width="56" height="26" rx="6" fill="var(--erased)" />
      <!-- 眼睛：X 和 O -->
      <path d="M84 91 l8 8 M92 91 l-8 8" stroke="var(--marker)" />
      <circle cx="112" cy="95" r="4" fill="none" />
      <!-- 天线 -->
      <path d="M100 70 v-18" />
      <circle class="lamp" cx="100" cy="48" r="5" fill="var(--marker)" />
    </g>
    <!-- 轮子 -->
    <g class="wheel" style="transform-origin: 78px 138px">
      <circle cx="78" cy="138" r="12" fill="var(--paper-2)" />
      <path d="M78 126 v24 M66 138 h24" />
    </g>
    <g class="wheel" style="transform-origin: 122px 138px">
      <circle cx="122" cy="138" r="12" fill="var(--paper-2)" />
      <path d="M122 126 v24 M110 138 h24" />
    </g>
    <!-- 问号 -->
    <text class="q" x="150" y="60">?</text>
  </svg>
  <div>
    <h1 class="big">404</h1>
    <p class="page-desc">这台机器人把地图弄丢了。定位失败，正在原地打转。</p>
    <a href="/" class="hand-btn">带它回首页 →</a>
  </div>
</div>

<style>
  .nf {
    display: grid;
    gap: 2rem;
    align-items: center;
    max-width: 44rem;
  }
  @media (min-width: 640px) {
    .nf {
      grid-template-columns: 14rem 1fr;
    }
  }
  .bot {
    width: 100%;
    fill: none;
    stroke: var(--pencil);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trail {
    stroke: var(--pencil-45);
    stroke-width: 2;
  }
  .body {
    animation: bob 2.2s ease-in-out infinite;
  }
  .wheel {
    animation: spin 1.6s linear infinite;
  }
  .wheel:last-of-type {
    animation-direction: reverse;
  }
  .lamp {
    animation: blink 1.2s steps(2, start) infinite;
  }
  .q {
    fill: var(--marker);
    stroke: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 40px;
    animation: bob 2.2s ease-in-out infinite reverse;
  }
  .big {
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 1;
    margin: 0 0 0.5rem;
    color: var(--marker);
  }
  .hand-btn {
    margin-top: 1rem;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-3px) rotate(-1.5deg);
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
</style>
