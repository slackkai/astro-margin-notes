---
/**
 * 原型 12：资料库排序 + 随机来一本。
 */
import LibraryCard from '../components/LibraryCard.astro';
import { getPosts } from '../utils/content';
const items = await getPosts('library');
const STATUS_ORDER: Record<string, number> = { reading: 0, todo: 1, done: 2 };
---

<div class="lib-lab">
  <div class="toolbar">
    <div class="sorts" role="group" aria-label="排序">
      <span class="meta">排序</span>
      <button class="hand-btn small is-on" data-sort="date">最新</button>
      <button class="hand-btn small" data-sort="rating">评分</button>
      <button class="hand-btn small" data-sort="status">在读优先</button>
    </div>
    <button class="hand-btn small dice" id="lab-random">🎲 随机来一本</button>
  </div>
  <div class="grid" id="lab-lib-grid">
    {
      items.map((it, i) => (
        <div
          data-date={it.data.date.valueOf()}
          data-rating={it.data.rating ?? 0}
          data-status={STATUS_ORDER[it.data.status ?? ''] ?? 3}
        >
          <LibraryCard
            href={`/library/${it.id}/`}
            title={it.data.title}
            type={it.data.type}
            url={it.data.url}
            author={it.data.author}
            rating={it.data.rating}
            status={it.data.status}
            summary={it.data.summary}
            tags={it.data.tags}
            rotate={i % 3 === 0 ? -0.5 : i % 3 === 1 ? 0.4 : -0.2}
          />
        </div>
      ))
    }
  </div>
</div>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .sorts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .hand-btn.is-on {
    background: var(--postit);
  }
  .grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .grid > div {
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  :global(.is-picked) {
    animation: pick 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.is-picked > .hand-card) {
    box-shadow: var(--shadow-hand) !important;
    background: var(--postit) !important;
  }
  @keyframes pick {
    0% {
      transform: rotate(0) scale(1);
    }
    30% {
      transform: rotate(-3deg) scale(1.05);
    }
    60% {
      transform: rotate(2deg) scale(1.04);
    }
    100% {
      transform: rotate(0) scale(1);
    }
  }
</style>

<script>
  function initLibLab() {
    const grid = document.getElementById('lab-lib-grid');
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = '1';
    const gridEl = grid;
    const btns = document.querySelectorAll<HTMLButtonElement>('.sorts [data-sort]');
    const dice = document.getElementById('lab-random');

    const sortBy = (key: string) => {
      const kids = [...gridEl.children] as HTMLElement[];
      kids.sort((a, b) => {
        const av = Number(a.dataset[key] ?? 0), bv = Number(b.dataset[key] ?? 0);
        return key === 'status' ? av - bv : bv - av;
      });
      kids.forEach((k) => gridEl.appendChild(k));
    };
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('is-on', x === b));
        sortBy(b.dataset.sort ?? 'date');
      }),
    );
    dice?.addEventListener('click', () => {
      const kids = [...gridEl.children] as HTMLElement[];
      kids.forEach((k) => k.classList.remove('is-picked'));
      const pick = kids[Math.floor(Math.random() * kids.length)];
      if (!pick) return;
      pick.scrollIntoView({ behavior: 'smooth', block: 'center' });
      void pick.offsetWidth;
      pick.classList.add('is-picked');
      setTimeout(() => pick.classList.remove('is-picked'), 2500);
    });
  }
  initLibLab();
  document.addEventListener('astro:page-load', initLibLab);
</script>
