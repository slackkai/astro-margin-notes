---
/**
 * 原型 9：日常热力图。最近 20 周，每格一天，按当天 dailies 数量着色。
 */
import { getPosts } from '../utils/content';

const WEEKS = 20;
const posts = await getPosts('dailies');
const counts = new Map<string, number>();
for (const p of posts) {
  const k = p.data.date.toISOString().slice(0, 10);
  counts.set(k, (counts.get(k) ?? 0) + 1);
}

// 从本周日往前推 WEEKS 周，列 = 周，行 = 周日..周六
const today = new Date();
today.setHours(0, 0, 0, 0);
const end = new Date(today);
end.setDate(end.getDate() + (6 - end.getDay())); // 本周六
const start = new Date(end);
start.setDate(start.getDate() - WEEKS * 7 + 1);

const weeks: { date: Date; key: string; n: number; future: boolean }[][] = [];
for (let w = 0; w < WEEKS; w++) {
  const col = [];
  for (let d = 0; d < 7; d++) {
    const date = new Date(start);
    date.setDate(start.getDate() + w * 7 + d);
    const key = date.toISOString().slice(0, 10);
    col.push({ date, key, n: counts.get(key) ?? 0, future: date > today });
  }
  weeks.push(col);
}
const monthLabels = weeks.map((col, i) => {
  const d = col[0].date;
  const prev = i > 0 ? weeks[i - 1][0].date : null;
  return !prev || prev.getMonth() !== d.getMonth() ? `${d.getMonth() + 1}月` : '';
});
const total = posts.filter((p) => p.data.date >= start).length;
---

<div class="heat hand-card">
  <div class="heat-head">
    <strong>最近 {WEEKS} 周</strong>
    <span class="meta">写了 {total} 条日常</span>
  </div>
  <div class="heat-grid" style={`--cols:${WEEKS}`}>
    <div class="months">
      {monthLabels.map((m) => <span>{m}</span>)}
    </div>
    <div class="cells">
      {
        weeks.map((col) => (
          <div class="col">
            {col.map((c) => (
              <span
                class:list={['cell', `l${Math.min(c.n, 3)}`, { future: c.future }]}
                title={`${c.key}${c.n ? ` · ${c.n} 条` : ''}`}
                style={`--jit:${((c.date.getDate() * 7) % 5) - 2}deg`}
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="legend meta">
    少 <span class="cell l0" /><span class="cell l1" /><span class="cell l2" /><span class="cell l3" /> 多
  </div>
</div>

<style>
  .heat {
    padding: 1.1rem 1.25rem 0.9rem;
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
  }
  .heat-head {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }
  .months {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1rem);
    gap: 0.25rem;
    font-size: 0.7rem;
    color: var(--pencil-45);
    margin-bottom: 0.2rem;
    white-space: nowrap;
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1rem);
    gap: 0.25rem;
  }
  .col {
    display: grid;
    grid-template-rows: repeat(7, 1rem);
    gap: 0.25rem;
  }
  .cell {
    width: 1rem;
    height: 1rem;
    display: inline-block;
    border: 1.5px solid var(--pencil-25);
    border-radius: 3px 5px 4px 5px / 5px 4px 5px 3px;
    background: transparent;
    transform: rotate(var(--jit, 0deg));
    transition: transform 0.12s ease;
  }
  .cell:hover {
    transform: rotate(0deg) scale(1.25);
    border-color: var(--pencil);
  }
  .cell.l1 {
    background: color-mix(in srgb, var(--pen) 30%, transparent);
    border-color: var(--pen);
  }
  .cell.l2 {
    background: color-mix(in srgb, var(--pen) 60%, transparent);
    border-color: var(--pen);
  }
  .cell.l3 {
    background: var(--pen);
    border-color: var(--pen);
  }
  .cell.future {
    border-style: dashed;
    opacity: 0.4;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.7rem;
    font-size: 0.8rem;
  }
</style>
