---
import { withBase } from '../../utils/url';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DailyItem from '../../components/DailyItem.astro';
import Heatmap from '../../components/Heatmap.astro';
import { SECTIONS, config } from '../../config';
import { getPosts, formatDate } from '../../utils/content';

const posts = await getPosts('dailies');
const sec = SECTIONS.dailies;

// 按月分组
const groups = new Map<string, typeof posts>();
for (const p of posts) {
  const key = formatDate(p.data.date, 'month');
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(p);
}

// 短内容直接渲染在时间线里
const rendered = await Promise.all(posts.map(async (p) => [p.id, (await render(p)).Content] as const));
const contentMap = new Map(rendered);
let idx = 3;
---

<BaseLayout title={sec.label} description={sec.desc}>
  <section class="container section narrow">
    <span class="postit reveal" style="--i:0">{sec.emoji} {sec.subtitle}</span>
    <h1 class="page-title reveal" style="--i:1">{sec.label}</h1>
    <p class="page-desc reveal" style="--i:2">{sec.desc}</p>

    <div class="reveal" style="--i:3; margin-top: 1.5rem">
      {config.features.heatmap && <Heatmap />}
    </div>

    {
      [...groups.entries()].map(([month, items]) => (
        <div class="month">
          <h2 class="month-title reveal" style={`--i:${idx++}`}>
            <span class="postit blue">{month}</span>
          </h2>
          <ul class="timeline">
            {items.map((p) => {
              const Content = contentMap.get(p.id)!;
              return (
                <DailyItem
                  href={withBase(`/dailies/${p.id}/`)}
                  title={p.data.title}
                  date={p.data.date}
                  mood={p.data.mood}
                  location={p.data.location}
                  tags={p.data.tags}
                  images={p.data.images}
                  index={idx++}
                  transitionName={p.data.title ? `dailies-${p.id}` : undefined}
                >
                  <Content />
                </DailyItem>
              );
            })}
          </ul>
        </div>
      ))
    }
    {posts.length === 0 && <p class="muted">还没有内容。</p>}
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 48rem;
  }
  .month {
    margin-top: 2.5rem;
  }
  .month-title {
    margin-bottom: 1.5rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
