---
import { withBase } from '../../utils/url';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { t } from '../../i18n';
import { getPosts, readingStats, gitLastModified, isProjectDoc, projectIdOf, projectDocs } from '../../utils/content';

/**
 * 项目页与项目文档页。projects/<项目>/index.md 是项目页；项目文件夹里的
 * <文档>/index.md 是项目文档，地址为 /projects/<项目>/<文档>/，页面上带回到项目的链接。
 */
export async function getStaticPaths() {
  const all = await getPosts('projects');
  const projects = all.filter((e) => !isProjectDoc(e));
  return all.map((post) => {
    const doc = isProjectDoc(post);
    const siblings = doc ? projectDocs(all, projectIdOf(post)) : projects;
    const i = siblings.findIndex((e) => e.id === post.id);
    return {
      params: { id: post.id },
      props: {
        post,
        prev: siblings[i + 1],
        next: siblings[i - 1],
        parent: doc ? projects.find((e) => e.id === projectIdOf(post)) : undefined,
        docs: doc ? [] : projectDocs(all, post.id),
      },
    };
  });
}

const { post, prev, next, parent, docs } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const links = [
  ['GitHub', d.links?.github],
  ['Demo', d.links?.demo],
  ['Paper', d.links?.paper],
  ['Docs', d.links?.docs],
].filter(([, u]) => u) as [string, string][];
const stats = readingStats(post.body);
const modified = await gitLastModified(post.filePath);
---

<PostLayout
  section="projects"
  title={d.title}
  description={d.description}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  image={d.cover}
  headings={headings}
  meta={{ ...stats, modified }}
  prev={prev && { href: `/projects/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/projects/${next.id}/`, title: next.data.title }}
>
  <div slot="extra" class="proj-meta">
    {parent && <a href={withBase(`/projects/${parent.id}/`)} class="doc-parent">📎 {t.projects.backTo(parent.data.title)}</a>}
    {
      !parent && (
        <div class="row">
          <span class="postit green">{t.projects.status[d.status] ?? d.status}</span>
          {d.stack.length > 0 && (
            <ul class="stack">
              {d.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          )}
        </div>
      )
    }
    {
      links.length > 0 && (
        <div class="links">
          {links.map(([label, u]) => (
            <a href={withBase(u)} target="_blank" rel="noopener" class="hand-btn small">
              {label}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {d.video ? <video class="media" src={withBase(d.video)} autoplay muted loop playsinline controls /> : d.cover && <img class="media" src={withBase(d.cover)} alt="" />}
  <Content />

  {
    docs.length > 0 && (
      <section class="project-docs" data-pagefind-ignore>
        <h2>{t.projects.docs}</h2>
        <div class="docs-grid">
          {docs.map((doc, i) => (
            <PostCard href={withBase(`/projects/${doc.id}/`)} title={doc.data.title} date={doc.data.date} description={doc.data.description} rotate={i % 2 ? 0.4 : -0.4} index={i} />
          ))}
        </div>
      </section>
    )
  }
</PostLayout>

<style>
  .proj-meta {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .doc-parent {
    align-self: flex-start;
    font-weight: 700;
    color: var(--pen);
    text-decoration: underline wavy;
    text-underline-offset: 4px;
  }
  .doc-parent:hover {
    color: var(--marker);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0 0.5rem;
    background: var(--erased);
    border-radius: 4px;
    color: var(--pencil-60);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .media {
    margin-bottom: 2rem;
    border: 3px solid var(--pencil);
    border-radius: 16px 24px 20px 18px / 18px 20px 24px 16px;
    box-shadow: var(--shadow-soft);
  }
  .project-docs {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--pencil-25);
  }
  .project-docs h2 {
    font-size: 1.4rem;
    margin: 0 0 1rem;
  }
  .docs-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .docs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
