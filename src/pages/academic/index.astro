---
import { withBase } from '../../utils/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Publications from '../../components/Publications.astro';
import { SECTIONS, config } from '../../config';
import { getPosts } from '../../utils/content';

const all = await getPosts('academic');
const papers = all.filter((p) => p.data.kind === 'paper');
const posts = all.filter((p) => p.data.kind !== 'paper');
const sec = SECTIONS.academic;

const KIND_LABEL: Record<string, string> = {
  note: '笔记',
  talk: '报告',
  course: '课程',
  project: '项目',
};
const kinds = [...new Set(posts.map((p) => p.data.kind))];
---

<BaseLayout title={sec.label} description={sec.desc}>
  <section class="container section">
    <span class="postit reveal" style="--i:0">{sec.emoji} {sec.subtitle}</span>
    <h1 class="page-title reveal" style="--i:1">{sec.label}</h1>
    <p class="page-desc reveal" style="--i:2">{sec.desc}</p>

    <!-- 研究方向 -->
    <div class="topics">
      {
        config.academic.topics.map((t, i) => (
          <div class="hand-card topic reveal" style={`--r:${i % 2 ? 0.6 : -0.6}deg; --i:${3 + i}`}>
            <span class="topic-emoji" aria-hidden="true">{t.emoji}</span>
            <strong>{t.title}</strong>
            <span class="muted">{t.desc}</span>
          </div>
        ))
      }
    </div>

    <!-- 发表 -->
    {papers.length > 0 && <Publications papers={papers} index={6} />}

    <!-- 笔记与其他 -->
    <div class="notes-head reveal" style="--i:7">
      <h2>Notes <span class="muted-zh">笔记与其他</span></h2>
      {
        kinds.length > 1 && (
          <div class="filters" role="group" aria-label="按类型筛选">
            <button class="hand-btn small is-on" data-kind="all">
              全部
            </button>
            {kinds.map((k) => (
              <button class="hand-btn small" data-kind={k}>
                {KIND_LABEL[k] ?? k}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="grid" id="academic-grid">
      {
        posts.map((p, i) => (
          <div data-kind={p.data.kind}>
            <PostCard
              href={withBase(`/academic/${p.id}/`)}
              title={p.data.title}
              date={p.data.date}
              description={p.data.description ?? p.data.venue}
              tags={p.data.tags}
              badge={KIND_LABEL[p.data.kind] ?? p.data.kind}
              rotate={i % 3 === 0 ? -0.5 : i % 3 === 1 ? 0.4 : -0.2}
              index={8 + i}
              transitionName={`academic-${p.id}`}
            />
          </div>
        ))
      }
    </div>
    {posts.length === 0 && <p class="muted">还没有笔记。</p>}
  </section>
</BaseLayout>

<style>
  .topics {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 2.5rem;
  }
  @media (min-width: 768px) {
    .topics {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.2rem;
    transform: rotate(var(--r));
  }
  .topic-emoji {
    font-size: 1.5rem;
  }
  .topic strong {
    font-size: 1.15rem;
  }
  .notes-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 3rem 0 1rem;
  }
  .notes-head h2 {
    font-size: 1.8rem;
  }
  .muted-zh {
    font-size: 1rem;
    font-weight: 400;
    color: var(--pencil-45);
    margin-left: 0.25rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hand-btn.is-on {
    background: var(--postit);
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  function bindFilters() {
    const grid = document.getElementById('academic-grid');
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = '1';
    const btns = document.querySelectorAll<HTMLButtonElement>('.filters [data-kind]');
    const items = grid.querySelectorAll<HTMLElement>(':scope > [data-kind]');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('is-on', x === b));
        const k = b.dataset.kind;
        items.forEach((it) => (it.style.display = k === 'all' || it.dataset.kind === k ? '' : 'none'));
      }),
    );
  }
  bindFilters();
  document.addEventListener('astro:page-load', bindFilters);
</script>
