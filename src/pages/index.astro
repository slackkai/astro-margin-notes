---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArmHero from '../components/ArmHero.astro';
import NowCard from '../components/NowCard.astro';
import SectionCard from '../components/SectionCard.astro';
import PostCard from '../components/PostCard.astro';
import LibraryCard from '../components/LibraryCard.astro';
import { SECTIONS } from '../consts';
import { getPosts, formatDate } from '../utils/content';

const [academic, insight, dailies, library] = await Promise.all([
  getPosts('academic'),
  getPosts('insight'),
  getPosts('dailies'),
  getPosts('library'),
]);

const latestInsight = insight.slice(0, 3);
const latestAcademic = academic.slice(0, 3);
const latestDailies = dailies.slice(0, 5);
const latestLibrary = library.slice(0, 3);

const counts = { academic: academic.length, insight: insight.length, dailies: dailies.length, library: library.length };
const rot = (i: number) => (i % 2 === 0 ? -0.5 : 0.5);
---

<BaseLayout>
  <ArmHero />

  <!-- 四个板块入口 -->
  <section class="container sections-grid">
    <SectionCard {...SECTIONS.academic} count={counts.academic} index={4} />
    <SectionCard {...SECTIONS.insight} count={counts.insight} index={5} />
    <SectionCard {...SECTIONS.dailies} count={counts.dailies} unit="条" index={6} />
    <SectionCard {...SECTIONS.library} count={counts.library} unit="项" index={7} />
  </section>

  <!-- Now 卡片 + 最新洞见 -->
  <section class="container section">
    <div class="two-col now-row">
      <div class="now-col">
        <NowCard index={8} />
      </div>

      <div class="panel reveal" style="--r:0.4deg; --i:9">
        <span class="panel-label">最新洞见</span>
        <div class="stack">
          {latestInsight.map((p, i) => (
            <PostCard
              href={`/insight/${p.id}/`}
              title={p.data.title}
              date={p.data.date}
              description={p.data.description}
              rotate={rot(i)}
              index={10 + i}
              transitionName={`insight-${p.id}`}
            />
          ))}
          {latestInsight.length === 0 && <p class="muted">还没有内容，去 src/content/insight 写第一篇吧。</p>}
        </div>
        <a href={SECTIONS.insight.href} class="hand-btn more">全部洞见 →</a>
      </div>
    </div>
  </section>

  <!-- 最新学术 + 日常快照 -->
  <section class="container section">
    <div class="two-col">
      <div class="panel reveal" style="--r:-0.4deg; --i:12">
        <span class="panel-label">最新学术</span>
        <div class="stack">
          {latestAcademic.map((p, i) => (
            <PostCard
              href={`/academic/${p.id}/`}
              title={p.data.title}
              date={p.data.date}
              description={p.data.description ?? p.data.venue}
              badge={p.data.kind}
              rotate={rot(i + 1)}
              index={13 + i}
              transitionName={`academic-${p.id}`}
            />
          ))}
          {latestAcademic.length === 0 && <p class="muted">还没有内容，去 src/content/academic 写第一篇吧。</p>}
        </div>
        <a href={SECTIONS.academic.href} class="hand-btn more">全部学术 →</a>
      </div>

      <div class="panel reveal" style="--r:0.3deg; --i:13">
        <span class="panel-label">日常快照</span>
        <ul class="daily-list">
          {latestDailies.map((d) => (
            <li>
              <a href={`/dailies/${d.id}/`} class="daily-row">
                <time class="meta">{formatDate(d.data.date, 'short')}</time>
                <span class="daily-row-title" transition:name={d.data.title ? `dailies-${d.id}` : undefined}>
                  {d.data.title ?? d.data.description ?? '（无题）'}
                </span>
                {d.data.mood && <span class="meta">{d.data.mood}</span>}
              </a>
            </li>
          ))}
          {latestDailies.length === 0 && <li class="muted">还没有日常记录。</li>}
        </ul>
        <a href={SECTIONS.dailies.href} class="hand-btn more">全部日常 →</a>
      </div>
    </div>
  </section>

  <!-- 资料库上新 -->
  <section class="container section">
    <div class="panel reveal" style="--r:-0.25deg; --i:15">
      <span class="panel-label">资料库上新</span>
      <div class="lib-grid">
        {latestLibrary.map((l, i) => (
          <LibraryCard
            href={`/library/${l.id}/`}
            title={l.data.title}
            type={l.data.type}
            url={l.data.url}
            author={l.data.author}
            rating={l.data.rating}
            status={l.data.status}
            summary={l.data.summary}
            rotate={rot(i)}
            index={16 + i}
            transitionName={`library-${l.id}`}
          />
        ))}
        {latestLibrary.length === 0 && <p class="muted">资料库还是空的。</p>}
      </div>
      <a href={SECTIONS.library.href} class="hand-btn more">进入资料库 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sections-grid {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  @media (min-width: 640px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sections-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .two-col {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .now-row {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
  .now-col {
    padding-top: 1.25rem;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lib-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .lib-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more {
    margin-top: 1.5rem;
  }
  .daily-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .daily-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
    transition: all 0.12s ease;
  }
  .daily-row:hover {
    border-style: solid;
    border-color: var(--pencil);
    background: var(--postit);
    transform: rotate(-0.5deg);
  }
  .daily-row-title {
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
