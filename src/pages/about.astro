---
import { withBase } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Workbench from '../components/Workbench.astro';
import { SITE, config, ENABLED_SECTIONS } from '../config';
import { t } from '../i18n';
import { getEntry, render } from 'astro:content';

// 关于页内容来自 src/content/about/about.md（后台“站点设置 → 关于页”可编辑）：
// 正文是自我介绍；highlights 为空时自动列出已启用板块；workbench 留空则不显示工作台。
const about = await getEntry('about', 'about');
const Intro = about?.body?.trim() ? (await render(about)).Content : null;
const highlights = about?.data.highlights.length
  ? about.data.highlights
  : ENABLED_SECTIONS.map((s) => ({ title: s.label, desc: s.desc }));
const workbench = about?.data.workbench;
---

<BaseLayout title="关于" description={`关于 ${SITE.title} 和它的作者`}>
  <section class="container section">
    <span class="postit reveal" style="--i:0">👋 你好</span>
    <h1 class="page-title reveal" style="--i:1">About</h1>

    <div class="about-grid">
      <div class="prose about-text reveal" style="--i:2">
        {Intro ? <Intro /> : <p>{t.about.defaultIntro(SITE.author)}</p>}
        <h2>{t.about.whatsHere}</h2>
        <ul>
          {highlights.map((h) => <li><strong>{h.title}</strong>{h.desc && `：${h.desc}`}</li>)}
        </ul>
        <h2>联系</h2>
        <p>
          {SITE.github && <a href={withBase(SITE.github)} target="_blank" rel="noopener">GitHub</a>}
          {SITE.email && <span> · <a href={withBase(`mailto:${SITE.email}`)}>{SITE.email}</a></span>}
          {config.features.guestbook && <span> · <a href={withBase('/guestbook/')}>给我留言</a></span>}
        </p>
        <p class="meta">本站使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，托管在 GitHub Pages。</p>
      </div>

      <aside class="hand-card about-card reveal taped" style="--i:3; --r:1deg">
        <div class="avatar" aria-hidden="true">{SITE.author.charAt(0).toUpperCase()}</div>
        <p class="about-name">{SITE.author}</p>
        <p class="meta">{SITE.tagline}</p>
      </aside>
    </div>

    {workbench && <h2 class="bench-title reveal" style="--i:4">{t.about.workbench} {t.about.workbenchEn && <span class="muted-zh">{t.about.workbenchEn}</span>}</h2>}
    {workbench && <Workbench workbench={workbench} />}
  </section>
</BaseLayout>

<style>
  .bench-title {
    font-size: 1.8rem;
    margin: 3rem 0 1.25rem;
  }
  .muted-zh {
    font-size: 1rem;
    font-weight: 400;
    color: var(--pencil-45);
    margin-left: 0.25rem;
  }
  .about-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 16rem;
      align-items: start;
    }
  }
  .about-text {
    margin-inline: 0;
  }
  .about-card {
    padding: 2rem 1.5rem 1.5rem;
    text-align: center;
    transform: rotate(var(--r));
  }
  .avatar {
    width: 6rem;
    height: 6rem;
    margin: 0 auto 1rem;
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: var(--pencil);
    background: var(--postit);
    border: 3px solid var(--pencil);
    border-radius: 50% 45% 55% 50% / 55% 50% 50% 45%;
    box-shadow: var(--shadow-hand);
  }
  .about-name {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
  }
</style>
