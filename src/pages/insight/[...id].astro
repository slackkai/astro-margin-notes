---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, getAllTagged, getSeries, readingStats, gitLastModified, relatedTo } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getPosts('insight');
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const stats = readingStats(post.body);
const modified = await gitLastModified(post.filePath);
const related = relatedTo(post, await getAllTagged());
const series = d.series ? { name: d.series.name, entries: await getSeries(d.series.name), current: post } : undefined;
---

<PostLayout
  section="insight"
  transitionName={`insight-${post.id}`}
  title={d.title}
  description={d.description}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  image={d.cover}
  headings={headings}
  meta={{ ...stats, modified }}
  series={series}
  related={related}
  prev={prev && { href: `/insight/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/insight/${next.id}/`, title: next.data.title }}
>
  {d.cover && <img src={d.cover} alt="" class="cover" />}
  <Content />
</PostLayout>

<style>
  .cover {
    margin-bottom: 2rem;
  }
</style>
