---
/**
 * /lab/ —— 个性化原型试验场。只在 `npm run dev` 下可见，生产构建不生成此页面。
 * 第三批（12–16）待定 + 第四批（17–22）。
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArmHero from '../../components/ArmHero.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import LibrarySort from '../../lab/LibrarySort.astro';
import Workbench from '../../lab/Workbench.astro';
import Search from '../../components/Search.astro';
import PostMeta from '../../components/PostMeta.astro';
import Related from '../../components/Related.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Archive from '../../components/Archive.astro';
import { getAllTagged, getPosts, getSeries, readingStats, gitLastModified, relatedTo } from '../../utils/content';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { slug: undefined } }] : [];
}

const items = [
  { id: 'arm-idle', title: '12 · 机械臂空闲活动', desc: '鼠标不在时每隔几秒自己伸向一个随机点。把鼠标移开等 4 秒。' },
  { id: 'toc', title: '13 · 文章目录', desc: '宽屏贴左侧页边并随滚动高亮；窄屏折叠在正文上方。' },
  { id: 'libsort', title: '14 · 资料库排序与随机', desc: '排序 + 随机来一本。' },
  { id: 'bench', title: '15 · 关于页工作台', desc: '工具、硬件、三个问题。文案占位。' },
  { id: 'signoff', title: '16 · 页脚结束语', desc: '页脚随机一句。点按钮换一句并滚到页脚。' },
  { id: 'search', title: '17 · 全站搜索', desc: 'Pagefind 静态索引。点按钮或按 / 或 Ctrl+K。索引需先 npm run build 再把 dist/pagefind 复制到 public/pagefind（已提供 npm run search:dev）。采纳后按钮放进导航栏。' },
  { id: 'meta', title: '18 · 文章元信息', desc: '字数、阅读时长、git 最后修改时间。下面用 Attention 笔记演示。' },
  { id: 'related', title: '19 · 相关文章', desc: '按标签重合度推荐三篇，放文章底部。下面是 Attention 笔记的推荐结果。' },
  { id: 'series', title: '20 · 合集', desc: 'frontmatter 里写 series: { name, order }，文章顶部显示合集导航。示例：两篇"从零搭四足控制器"。' },
  { id: 'projects', title: '21 · Projects 项目页', desc: '新集合 src/content/projects，卡片含状态、技术栈、链接，支持封面或短视频。采纳后加入导航。' },
  { id: 'archive', title: '22 · 归档', desc: '全站按年月一行一条。采纳后加到导航或页脚。' },
];

const fakeHeadings = [
  { depth: 2, slug: 'lab-h-1', text: '为什么需要目录' },
  { depth: 2, slug: 'lab-h-2', text: '它怎么工作' },
  { depth: 3, slug: 'lab-h-2-1', text: '高亮当前章节' },
  { depth: 3, slug: 'lab-h-2-2', text: '窄屏折叠' },
  { depth: 2, slug: 'lab-h-3', text: '什么时候不显示' },
];
const filler = '这是一段用来撑长度的占位文字。目录在左侧随滚动高亮当前章节。你可以点目录项跳转，也可以直接滚动观察高亮变化。';

// 18 / 19：以 Attention 笔记为样本
const sample = await getEntry('academic', 'attention-is-all-you-need');
const stats = readingStats(sample?.body);
const modified = await gitLastModified(sample?.filePath);
const related = sample ? relatedTo(sample, await getAllTagged()) : [];

// 20
const seriesName = '从零搭四足控制器';
const seriesEntries = await getSeries(seriesName);

// 21
const projects = await getPosts('projects');
---

<BaseLayout title="Lab" description="个性化原型试验场" signoff>
  <ReadingProgress />
  <div class="lab" id="lab" data-pagefind-ignore>
    <section class="container section">
      <span class="postit">🧪 Lab · 仅本地可见</span>
      <h1 class="page-title">原型试验场</h1>
      <p class="page-desc">每一块是一个独立提案。看完告诉我编号：并入、修改、或删掉。</p>
      <ol class="toc-list" start="12">
        {items.map((it) => (
          <li>
            <a href={`#${it.id}`}>{it.title}</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="container lab-item" id="arm-idle">
      <div class="lab-head"><h2>{items[0].title}</h2><p class="muted">{items[0].desc}</p></div>
    </section>
    <ArmHero idle />

    <section class="container lab-item" id="toc">
      <div class="lab-head"><h2>{items[1].title}</h2><p class="muted">{items[1].desc}</p></div>
      <div class="fake-article">
        <Toc headings={fakeHeadings} />
        <div class="prose">
          <h2 id="lab-h-1">为什么需要目录</h2>
          {[1, 2, 3].map(() => <p>{filler}</p>)}
          <h2 id="lab-h-2">它怎么工作</h2>
          {[1, 2].map(() => <p>{filler}</p>)}
          <h3 id="lab-h-2-1">高亮当前章节</h3>
          {[1, 2, 3].map(() => <p>{filler}</p>)}
          <h3 id="lab-h-2-2">窄屏折叠</h3>
          {[1, 2].map(() => <p>{filler}</p>)}
          <h2 id="lab-h-3">什么时候不显示</h2>
          <p>标题少于两个时目录不渲染。</p>
          {[1, 2].map(() => <p>{filler}</p>)}
        </div>
      </div>
    </section>

    <section class="container lab-item" id="libsort">
      <div class="lab-head"><h2>{items[2].title}</h2><p class="muted">{items[2].desc}</p></div>
      <LibrarySort />
    </section>

    <section class="container lab-item" id="bench">
      <div class="lab-head"><h2>{items[3].title}</h2><p class="muted">{items[3].desc}</p></div>
      <Workbench />
    </section>

    <section class="container lab-item" id="signoff">
      <div class="lab-head"><h2>{items[4].title}</h2><p class="muted">{items[4].desc}</p></div>
      <button class="hand-btn small" id="signoff-next">换一句并滚到页脚</button>
    </section>

    <section class="container lab-item" id="search">
      <div class="lab-head"><h2>{items[5].title}</h2><p class="muted">{items[5].desc}</p></div>
      <div class="row"><Search /><span class="meta">← 点这个，或按 <kbd>/</kbd></span></div>
    </section>

    <section class="container lab-item" id="meta">
      <div class="lab-head"><h2>{items[6].title}</h2><p class="muted">{items[6].desc}</p></div>
      <div class="hand-card demo-card">
        <h3>{sample?.data.title}</h3>
        <PostMeta words={stats.words} minutes={stats.minutes} modified={modified} />
      </div>
    </section>

    <section class="container lab-item" id="related">
      <div class="lab-head"><h2>{items[7].title}</h2><p class="muted">{items[7].desc}</p></div>
      <Related entries={related} />
      {related.length === 0 && <p class="muted">没有标签重合的文章。</p>}
    </section>

    <section class="container lab-item" id="series">
      <div class="lab-head"><h2>{items[8].title}</h2><p class="muted">{items[8].desc}</p></div>
      {seriesEntries.length > 0 && <SeriesNav name={seriesName} entries={seriesEntries} current={seriesEntries[0]} />}
    </section>

    <section class="container lab-item" id="projects">
      <div class="lab-head"><h2>{items[9].title}</h2><p class="muted">{items[9].desc}</p></div>
      <div class="proj-grid">
        {projects.map((p, i) => <ProjectCard project={p} rotate={i % 2 ? 0.4 : -0.4} index={i} />)}
      </div>
    </section>

    <section class="container lab-item" id="archive">
      <div class="lab-head"><h2>{items[10].title}</h2><p class="muted">{items[10].desc}</p></div>
      <Archive />
    </section>
  </div>
</BaseLayout>

<style>
  .toc-list {
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
    columns: 2;
    font-weight: 700;
  }
  .toc-list a:hover {
    color: var(--marker);
  }
  .lab-item {
    padding-block: 2.5rem;
    border-top: 2px dashed var(--pencil-25);
  }
  .lab-head h2 {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }
  .lab-head p {
    margin: 0 0 1.5rem;
    max-width: 44rem;
  }
  .fake-article {
    position: relative;
  }
  .fake-article .prose {
    margin-inline: auto;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .row kbd {
    font-family: var(--font-mono);
    border: 1.5px solid var(--pencil-25);
    border-radius: 4px;
    padding: 0 0.3rem;
  }
  .demo-card {
    padding: 1rem 1.25rem;
    max-width: 30rem;
  }
  .demo-card h3 {
    font-size: 1.2rem;
  }
  .proj-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .proj-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .proj-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  function initSignoffDemo() {
    const btn = document.getElementById('signoff-next');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const el = document.getElementById('site-signoff');
      const text = el?.querySelector<HTMLElement>('.signoff-text');
      if (!el || !text) return;
      const lines: string[] = JSON.parse(el.dataset.lines ?? '[]');
      const cur = text.textContent;
      let next = cur;
      while (next === cur && lines.length > 1) next = lines[Math.floor(Math.random() * lines.length)];
      text.style.animation = 'none';
      void text.offsetWidth;
      text.style.animation = '';
      text.textContent = next ?? '';
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
  initSignoffDemo();
  document.addEventListener('astro:page-load', initSignoffDemo);
</script>
