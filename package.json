{
  "name": "astro-margin-notes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "search:dev": "astro build && pagefind --site dist && node -e \"require('fs').cpSync('dist/pagefind','public/pagefind',{recursive:true})\"",
    "astro": "astro",
    "predev": "node scripts/prepare-cms.mjs",
    "prebuild": "node scripts/prepare-cms.mjs",
    "new": "node scripts/new-post.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:production": "node scripts/test-production.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "giscus": "^1.6.0",
    "katex": "^0.16.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "rehype-katex": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@sveltia/cms": "0.216.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "typescript": "^5.0.0"
  },
  "description": "A hand-drawn notebook Astro theme with a Git-based visual CMS and GitHub Pages deployment.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
